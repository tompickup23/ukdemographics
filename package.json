{
  "name": "ukdemographics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "fetch:lancashirecc": "node scripts/fetch/fetch-lancashire-cc.mjs",
    "fetch:homeoffice": "node scripts/fetch/fetch-home-office.mjs",
    "fetch:evci": "node scripts/fetch/fetch-evci.mjs",
    "fetch:childbenefit": "node scripts/fetch/fetch-child-benefit.mjs",
    "transform:lancashirecc": "node scripts/transform/transform-lancashire-cc.mjs",
    "ingest:lancashirecc": "npm run fetch:lancashirecc && npm run transform:lancashirecc",
    "test": "vitest run",
    "test:mobile": "playwright test tests/mobile-layout.spec.ts --project=mobile-chromium",
    "test:desktop": "playwright test tests/desktop-layout.spec.ts --project=desktop-chromium",
    "test:watch": "vitest",
    "validate:projections": "node scripts/validate-projections.mjs",
    "validate:oos": "node scripts/model/validate_out_of_sample.mjs",
    "fetch:census2001": "node scripts/fetch/fetch-census-2001-ethnicity-age.mjs",
    "reconcile:derived": "node scripts/model/reconcile_derived.mjs",
    "canonicalise:codes": "node scripts/model/canonicalise_area_codes.mjs",
    "canonicalise:codes:check": "node scripts/model/canonicalise_area_codes.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/sora": "^5.2.8",
    "@fontsource/source-sans-3": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/d3-geo": "^3.1.0",
    "astro": "^6.3.6",
    "d3-geo": "^3.1.1",
    "satori": "^0.26.0",
    "sharp": "^0.34.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.3.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
