---
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";
import {
  DEFAULT_DESCRIPTION,
  DEFAULT_SOCIAL_IMAGE_PATH,
  SITE_NAME,
  SITE_URL,
  normalisePageTitle,
  type StructuredDataNode
} from "../lib/site";

interface Props {
  title: string;
  description?: string;
  image?: string;
  noIndex?: boolean;
  structuredData?: StructuredDataNode[];
  bodyClass?: string;
  mainClass?: string;
  hideFooter?: boolean;
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  image = DEFAULT_SOCIAL_IMAGE_PATH,
  noIndex = false,
  structuredData: pageStructuredData = [],
  bodyClass,
  mainClass,
  hideFooter = false
} = Astro.props;
const siteOrigin = Astro.site ?? new URL(SITE_URL);
const pathname = Astro.url.pathname || "/";
const pageTitle = normalisePageTitle(title);
const canonicalUrl = new URL(pathname, siteOrigin).toString();
const socialImageUrl = /^https?:\/\//.test(image) ? image : new URL(image, siteOrigin).toString();
const robotsContent = noIndex ? "noindex,follow,max-image-preview:large" : "index,follow,max-image-preview:large";
const socialImageMime = socialImageUrl.endsWith(".png")
  ? "image/png"
  : socialImageUrl.endsWith(".webp")
    ? "image/webp"
    : socialImageUrl.endsWith(".svg")
      ? "image/svg+xml"
      : undefined;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: pageTitle,
    description,
    url: canonicalUrl,
    inLanguage: "en-GB",
    isPartOf: {
      "@id": `${SITE_URL}/#website`
    },
    primaryImageOfPage: {
      "@type": "ImageObject",
      url: socialImageUrl
    }
  },
  ...(pathname === "/"
    ? [
        {
          "@context": "https://schema.org",
          "@type": "WebSite",
          "@id": `${SITE_URL}/#website`,
          url: SITE_URL,
          name: SITE_NAME,
          description: DEFAULT_DESCRIPTION,
          inLanguage: "en-GB",
          publisher: {
            "@id": `${SITE_URL}/#organization`
          }
        },
        {
          "@context": "https://schema.org",
          "@type": "Organization",
          "@id": `${SITE_URL}/#organization`,
          name: SITE_NAME,
          url: SITE_URL,
          logo: {
            "@type": "ImageObject",
            url: new URL("/favicon.svg", siteOrigin).toString()
          }
        }
      ]
    : []),
  ...pageStructuredData
];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <meta name="theme-color" content="#050812" />
    <meta name="color-scheme" content="dark light" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    {socialImageMime && <meta property="og:image:type" content={socialImageMime} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${pageTitle} - ukdemographics.co.uk`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@UKDemographics" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={`${pageTitle} - ukdemographics.co.uk`} />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://api.postcodes.io https://cloudflareinsights.com; frame-src https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" />
    <!-- Fonts self-hosted via Fontsource (imported in global.css) -->
    <meta name="google-site-verification" content="0NnwYAx2MjnJ1it-L-2U2FvYnQj-gB3dYWMGntGL-0E" />
    <!-- Cloudflare Web Analytics --><script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "b46b578caa974eeaa429fabf1cfaa932"}'></script><!-- End Cloudflare Web Analytics -->
    {structuredData.map((item) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(item)} />
    ))}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader />
    <main id="main-content" class:list={["shell", mainClass]} tabindex="-1">
      <slot />
    </main>
    {!hideFooter && (
      <footer class="shell footer">
        <section class="footer-sisters" aria-labelledby="footer-sisters-heading">
          <h2 id="footer-sisters-heading" class="footer-sisters-eyebrow">Sister sites</h2>
          <div class="footer-sisters-grid">
            <a class="footer-sister-card footer-sister-card--uke" href="https://ukelections.co.uk" rel="noopener">
              <span class="footer-sister-tile" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 64 64">
                  <rect x="8" y="6" width="48" height="52" rx="3" fill="#e3d9c3"></rect>
                  <path d="M22 22 L42 42 M42 22 L22 42" stroke="#6b5334" stroke-width="7" stroke-linecap="square" fill="none"></path>
                </svg>
              </span>
              <span class="footer-sister-body">
                <span class="footer-sister-name">ukelections.co.uk</span>
                <span class="footer-sister-tagline">Election forecasts, council control &amp; by&#8209;election outcomes</span>
              </span>
              <span class="footer-sister-arrow" aria-hidden="true">&#8599;</span>
            </a>
            <a class="footer-sister-card footer-sister-card--as" href="https://asylumstats.co.uk" rel="noopener">
              <span class="footer-sister-tile" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 64 64">
                  <rect x="10" y="26" width="18" height="34" fill="#f4f6f7"></rect>
                  <rect x="36" y="6" width="18" height="54" fill="#82abcb"></rect>
                </svg>
              </span>
              <span class="footer-sister-body">
                <span class="footer-sister-name">asylumstats.co.uk</span>
                <span class="footer-sister-tagline">Asylum spending, dispersal &amp; route data</span>
              </span>
              <span class="footer-sister-arrow" aria-hidden="true">&#8599;</span>
            </a>
          </div>
        </section>
        <div class="footer-main">
          Every projection sourced. Every figure checked. Population data you can trust. &middot;
          <a href="/sources/">Sources</a> &middot;
          <a href="/methodology/">Methodology</a> &middot;
          <a href="/findings/">Research</a> &middot;
          <a href="/glossary/">Glossary</a>
        </div>
        <div class="footer-legal-links">
          <a href="/privacy/">Privacy</a> &middot;
          <a href="/terms/">Terms</a> &middot;
          <a href="/accessibility/">Accessibility</a>
        </div>
        <div class="footer-legal">
          ukdemographics.co.uk is an independent demographic research project. It uses publicly available government data (ONS Census 2021, SNPP, DfE School Census, NHS Digital).
          Not affiliated with or endorsed by any political party, council, or candidate. No cookies. No tracking. No personal data collected.
          &copy; {new Date().getFullYear()} ukdemographics.co.uk. All projections are demographic estimates, not predictions.
          <a href="/methodology/">Full methodology &amp; limitations</a>.
        </div>
      </footer>
    )}

    <style is:global>
      .footer-sisters {
        margin: 0 0 1.5rem;
      }
      .footer-sisters-eyebrow {
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
        margin: 0 0 0.65rem;
      }
      .footer-sisters-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.85rem;
      }
      .footer-sister-card {
        display: grid;
        grid-template-columns: 44px 1fr auto;
        align-items: center;
        gap: 0.85rem;
        padding: 0.85rem 1rem;
        border-radius: 14px;
        text-decoration: none;
        border: 1px solid var(--border);
        background: color-mix(in srgb, var(--bg-soft) 60%, transparent);
        transition: transform 180ms, border-color 180ms, box-shadow 180ms, background 180ms;
      }
      .footer-sister-card:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 22px rgba(0, 0, 0, 0.3);
      }
      .footer-sister-tile {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 0.78rem;
        letter-spacing: 0.04em;
        color: #ffffff;
      }
      .footer-sister-body {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        min-width: 0;
      }
      .footer-sister-name {
        font-weight: 600;
        font-size: 0.92rem;
        color: var(--ink);
        line-height: 1.2;
      }
      .footer-sister-tagline {
        font-size: 0.78rem;
        color: var(--muted);
        line-height: 1.3;
      }
      .footer-sister-arrow {
        font-size: 1rem;
        color: var(--muted);
        align-self: start;
        margin-top: 2px;
      }
      /* Each sister carries its own accent triple, which is the only thing that tells
         the five sites apart. UK Elections takes no party hue on purpose: red reads
         Labour, blue Conservative, turquoise Reform, so on a neutral forecast site every
         hue is a claim. It brands in parchment, the colour of a ballot paper. */
      .footer-sister-card--uke .footer-sister-tile {
        background: #6b5334;
        box-shadow: 0 6px 14px rgba(107, 83, 52, 0.28);
      }
      .footer-sister-card--uke:hover {
        border-color: rgba(107, 83, 52, 0.55);
      }
      .footer-sister-card--as .footer-sister-tile {
        background: #2f5773;
        box-shadow: 0 6px 14px rgba(47, 87, 115, 0.28);
      }
      .footer-sister-card--as:hover {
        border-color: rgba(47, 87, 115, 0.55);
      }
      @media (max-width: 640px) {
        .footer-sisters-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </body>
</html>
