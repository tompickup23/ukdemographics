---
/**
 * RaceBar.astro — horizontal stacked-bar race showing categorical shares.
 *
 * Ported from UKE 19 May 2026 and generalised: drop the party-only
 * semantics so the same bar works for ethnic composition, country-of-
 * birth groups, tenure mix, English-proficiency bands, vote shares
 * (when wired to a colour palette), etc.
 *
 * Each segment supplies its own colour + label — no implicit party
 * lookups. Callers pass the colour from whichever palette they own.
 *
 * Props:
 *   segments: ordered [{label, pct, colour, captionLabel?, captionValue?}]
 *             where pct is 0..1; segments should sum to ≤ 1.
 *   height: px; default 64
 *   showLegend: bool; default true
 *   title: optional title rendered above the bar
 *   ariaLabel: a11y label for the bar
 *   labelMinPct: hide inline label in segments narrower than this (default 0.08)
 *   captionLabel: optional caption shown below each legend row
 *                 (e.g. "Census 2021" or a sub-group name)
 */
interface Segment {
  label: string;
  pct: number;
  colour: string;
  captionLabel?: string;
  captionValue?: string;
}

interface Props {
  segments: Segment[];
  height?: number;
  showLegend?: boolean;
  title?: string | null;
  ariaLabel?: string;
  labelMinPct?: number;
}

const {
  segments,
  height = 64,
  showLegend = true,
  title = null,
  ariaLabel = "Stacked composition bar",
  labelMinPct = 0.08,
} = Astro.props;

function fmtPct(p: number): string {
  return `${(p * 100).toFixed(1)}%`;
}
---

<div class="hero-race">
  {title && <p class="hero-race-title">{title}</p>}
  <div
    class="hero-race-bar"
    role="img"
    aria-label={ariaLabel}
    style={`height:${height}px`}
  >
    {segments.map((s) => {
      const wide = s.pct >= labelMinPct;
      return (
        <div
          class="hero-race-segment"
          style={`flex-basis:${(s.pct * 100).toFixed(2)}%; background:${s.colour}`}
          title={`${s.label} ${fmtPct(s.pct)}${s.captionLabel ? ` — ${s.captionLabel}` : ""}`}
        >
          {wide && (
            <span class="hero-race-label">
              <span class="hero-race-party">{s.label}</span>
              <span class="hero-race-pct">{fmtPct(s.pct)}</span>
            </span>
          )}
        </div>
      );
    })}
  </div>
  {showLegend && (
    <ul class="hero-race-legend">
      {segments.map((s) => (
        <li>
          <span class="hero-race-swatch" style={`background:${s.colour}`}></span>
          <span class="hero-race-legend-party">{s.label}</span>
          <span class="hero-race-legend-pct">{fmtPct(s.pct)}</span>
          {s.captionLabel && <span class="hero-race-legend-cand">{s.captionLabel}</span>}
        </li>
      ))}
    </ul>
  )}
</div>
