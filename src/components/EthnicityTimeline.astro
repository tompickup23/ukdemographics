---
import { ETHNIC_PALETTE, ETHNIC_GROUP_KEYS } from "../lib/ethnic-palette";

/**
 * Animated stacked bar chart showing ethnic composition change over decades.
 * Shows absolute or percentage breakdown for each census/projection year.
 */
interface EthnicSnapshot {
  year: string;
  groups: {
    white_british: number;
    white_other: number;
    asian: number;
    black: number;
    mixed: number;
    other: number;
  };
  isProjection: boolean;
}

interface Props {
  timeline: EthnicSnapshot[];
  areaName: string;
}

const { timeline, areaName } = Astro.props;
// The caption names the last year drawn: the bars stop at each council's own horizon.
const lastProjected = timeline.filter((t) => t.isProjection).map((t) => t.year).pop();

const groupLabels = Object.fromEntries(ETHNIC_PALETTE.map((g) => [g.key, g.label])) as Record<string, string>;
const groupColors = Object.fromEntries(ETHNIC_PALETTE.map((g) => [g.key, g.fill])) as Record<string, string>;
const groupInk = Object.fromEntries(ETHNIC_PALETTE.map((g) => [g.key, g.ink])) as Record<string, "dark" | "light">;

const groupKeys = ETHNIC_GROUP_KEYS;

// Build bar data
const barData = timeline.map(snap => {
  const total = groupKeys.reduce((sum, k) => sum + snap.groups[k], 0);
  return {
    year: snap.year,
    isProjection: snap.isProjection,
    segments: groupKeys.map(k => ({
      key: k,
      label: groupLabels[k],
      color: groupColors[k],
      pct: total > 0 ? snap.groups[k] : 0,
      value: snap.groups[k]
    })).filter(s => s.pct > 1) // hide < 1%
  };
});
---

<figure class="eth-timeline">
  <div class="eth-timeline-head">
    <h3>Ethnic composition: {areaName}</h3>
    <p class="tiny">{lastProjected ? `Census 2011, Census 2021, then Hamilton-Perry projections to ${lastProjected}. Percentages.` : "Census 2011 and Census 2021. Percentages."}</p>
  </div>

  <div class="eth-bars">
    {barData.map(bar => (
      <div class={`eth-bar-row ${bar.isProjection ? "eth-projected" : ""}`}>
        <span class="eth-year">
          {bar.year}
          {bar.isProjection && <span class="eth-proj-badge">proj</span>}
        </span>
        <div class="eth-bar-track">
          {bar.segments.map(seg => (
            <div
              class={`eth-segment eth-ink-${groupInk[seg.key]}`}
              style={`width: ${seg.pct}%; background: ${seg.color};`}
              title={`${seg.label}: ${seg.pct.toFixed(1)}%`}
            >
              {seg.pct >= 8 && (
                <span class="eth-seg-label">{seg.pct.toFixed(0)}%</span>
              )}
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div class="eth-legend">
    {groupKeys.map(k => (
      <span class="eth-legend-item">
        <span class="eth-legend-dot" style={`background: ${groupColors[k]}`}></span>
        {groupLabels[k]}
      </span>
    ))}
  </div>
</figure>

<style>
  .eth-timeline {
    padding: 1.25rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--panel);
  }
  .eth-timeline-head h3 {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 0.15rem;
    color: var(--ink);
  }
  .eth-bars {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .eth-bar-row {
    display: grid;
    grid-template-columns: 70px 1fr;
    align-items: center;
    gap: 0.5rem;
  }
  .eth-year {
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .eth-proj-badge {
    font-size: 0.62rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--warning);
    background: color-mix(in srgb, var(--warning) 10%, var(--panel));
    padding: 0.1rem 0.3rem;
    border-radius: 4px;
  }
  .eth-bar-track {
    display: flex;
    height: 32px;
    border-radius: 6px;
    overflow: hidden;
    background: var(--bg-subtle);
    outline: 1px solid var(--border);
  }
  .eth-segment {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 2px;
    transition: width 400ms ease;
    position: relative;
  }
  /* Each label takes the ink that passes on its own segment, 4.5:1 or more in both
     schemes (src/lib/ethnic-palette.ts; maps plan v2.2, issues I17 and I24). */
  .eth-seg-label {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--on-fill-light);
    pointer-events: none;
  }
  .eth-ink-light .eth-seg-label {
    color: var(--on-fill-dark);
  }
  /* A hairline of the panel between segments, so neighbouring groups never merge. */
  .eth-segment + .eth-segment {
    box-shadow: inset 1px 0 0 var(--panel);
  }
  /* Projected rows are marked by the badge and a dashed outline. They were faded
     with opacity, which took every label in them below 4.5:1. */
  .eth-projected .eth-bar-track {
    outline: 1px dashed var(--border-strong);
    outline-offset: 2px;
  }
  .eth-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 0.75rem;
  }
  .eth-legend-item {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .eth-legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    flex-shrink: 0;
  }
  @media (max-width: 640px) {
    .eth-bar-row { grid-template-columns: 55px 1fr; }
    .eth-bar-track { height: 26px; }
    .eth-year { font-size: 0.78rem; }
    .eth-seg-label { font-size: 0.62rem; }
  }
</style>
