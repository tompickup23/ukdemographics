---
/**
 * How many councils fall in each range of one measure: a histogram drawn at build
 * time as inline SVG, with the same counts in a table beneath it. It names no area
 * and orders none (see src/lib/distribution.ts). Text is 13 units on a 480-unit
 * viewBox, so it stays at 9 px or more on a 360 px phone.
 */
import { binValues, formatEdge } from "../lib/distribution";

interface Band { from: number; to: number; label: string }
interface Marker { at: number; label: string }
interface Props {
  id: string;
  title: string;
  values: Array<number | null | undefined>;
  step: number;
  /** Axis title, for example "Change in social rent share, percentage points". */
  axisLabel: string;
  /** Suffix on each range in the table, for example "pp". */
  unit?: string;
  /** What a value is a count of, plural: "councils". */
  noun?: string;
  min?: number;
  max?: number;
  bands?: Band[];
  markers?: Marker[];
  source: string;
  note?: string;
}

const {
  id, title, values, step, axisLabel, unit = "", noun = "councils",
  min, max, bands = [], markers = [], source, note,
} = Astro.props;

const { bins, n } = binValues(values, step, { min, max });

const W = 480, H = 260, L = 34, R = 12, T = bands.length ? 40 : 28, B = 50;
const lo = bins[0]?.from ?? 0;
const hi = bins[bins.length - 1]?.to ?? 1;
const top = Math.max(1, ...bins.map((b) => b.count));
// Whole-number count ticks: 4 or 5 steps of 1, 2, 5, 10, 20, 25, 50 ...
const tickStep = [1, 2, 5, 10, 20, 25, 50, 100, 200].find((s) => top / s <= 5) ?? 500;
const yMax = Math.ceil(top / tickStep) * tickStep;
const yTicks = Array.from({ length: yMax / tickStep + 1 }, (_, i) => i * tickStep);

const x = (v: number) => L + ((v - lo) / (hi - lo)) * (W - L - R);
const y = (c: number) => T + (1 - c / yMax) * (H - T - B);
const barW = (W - L - R) / Math.max(1, bins.length);

// Label every k-th edge so that range labels never run into each other.
const edges = [lo, ...bins.map((b) => b.to)];
const every = Math.max(1, Math.ceil(edges.length / 8));
const edgeLabels = edges.filter((e, i) =>
  i === edges.length - 1 || (i % every === 0 && x(hi) - x(e) >= 50));

const range = (b: { from: number; to: number }, last: boolean) =>
  `${formatEdge(b.from, step)}${unit} to ${last ? "" : "under "}${formatEdge(b.to, step)}${unit}`;

const aria = `Histogram: ${n.toLocaleString("en-GB")} ${noun} by ${axisLabel.toLowerCase()}, in steps of ${formatEdge(step, step)}${unit}. ` +
  `The largest group is ${top.toLocaleString("en-GB")} ${noun}. The table below the chart gives every count.`;
---

<figure class="dist-chart" aria-labelledby={`${id}-title`}>
  <figcaption id={`${id}-title`} class="dist-title">{title}</figcaption>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={aria}>
    {bands.map((band, i) => {
      const x0 = x(Math.max(lo, band.from));
      const x1 = x(Math.min(hi, band.to));
      if (x1 <= x0) return null;
      return (
        <g class="dist-band">
          <rect class={i % 2 ? "dist-band-b" : "dist-band-a"} x={x0} y={T} width={x1 - x0} height={H - T - B} />
          {x1 - x0 >= 44 && <text x={(x0 + x1) / 2} y={T - 10} text-anchor="middle">{band.label}</text>}
        </g>
      );
    })}
    {yTicks.map((t) => (
      <g class="dist-grid">
        <line x1={L} x2={W - R} y1={y(t)} y2={y(t)} />
        <text x={L - 6} y={y(t) + 4.5} text-anchor="end">{t}</text>
      </g>
    ))}
    {bins.map((b, i) => b.count > 0 && (
      <rect class="dist-bar" x={x(b.from) + 1} y={y(b.count)} width={Math.max(1, barW - 2)} height={y(0) - y(b.count)}>
        <title>{range(b, i === bins.length - 1)}: {b.count} {b.count === 1 ? noun.replace(/s$/, "") : noun}</title>
      </rect>
    ))}
    {markers.filter((m) => m.at >= lo && m.at <= hi).map((m) => (
      <g class="dist-marker">
        <line x1={x(m.at)} x2={x(m.at)} y1={T - 2} y2={y(0)} />
        <text x={x(m.at) + 4} y={T + 12} text-anchor={x(m.at) > W - 120 ? "end" : "start"} dx={x(m.at) > W - 120 ? -8 : 0}>{m.label}</text>
      </g>
    ))}
    <line class="dist-axis" x1={L} x2={W - R} y1={y(0)} y2={y(0)} />
    {edgeLabels.map((e, i) => (
      <text class="dist-tick" x={x(e)} y={y(0) + 17} text-anchor={i === 0 ? "start" : e === hi ? "end" : "middle"}>{formatEdge(e, step)}</text>
    ))}
    <text class="dist-axis-title" x={(L + W - R) / 2} y={H - 8} text-anchor="middle">{axisLabel}</text>
    <text class="dist-axis-title" x={0} y={T - (bands.length ? 22 : 6)} text-anchor="start">{noun[0].toUpperCase() + noun.slice(1)}</text>
  </svg>
  <details class="dist-table">
    <summary>The counts as a table</summary>
    <table>
      <thead><tr><th scope="col">Range</th><th scope="col" class="num">{noun[0].toUpperCase() + noun.slice(1)}</th></tr></thead>
      <tbody>
        {bins.map((b, i) => (
          <tr><td>{range(b, i === bins.length - 1)}</td><td class="num">{b.count}</td></tr>
        ))}
        <tr class="dist-total"><td>All</td><td class="num">{n}</td></tr>
      </tbody>
    </table>
  </details>
  <p class="dist-source">Source: {source}.{note ? ` ${note}` : ""}</p>
</figure>

<style>
  .dist-chart { margin: 0 0 2rem; max-width: 600px; }
  .dist-title { font-family: var(--font-display); font-size: 1rem; font-weight: 600; color: var(--ink); margin: 0 0 0.5rem; }
  .dist-chart svg { display: block; width: 100%; height: auto; overflow: visible; }
  .dist-grid line { stroke: var(--border); stroke-width: 1; }
  .dist-grid text, .dist-tick, .dist-axis-title, .dist-band text, .dist-marker text { fill: var(--muted); font-size: 13px; }
  .dist-axis-title { font-size: 13px; }
  .dist-axis { stroke: var(--border-strong); stroke-width: 1; }
  .dist-bar { fill: var(--accent); }
  .dist-bar:hover { fill: color-mix(in srgb, var(--accent) 75%, var(--ink)); }
  .dist-band-a { fill: color-mix(in srgb, var(--ink) 4%, transparent); }
  .dist-band-b { fill: color-mix(in srgb, var(--ink) 9%, transparent); }
  .dist-marker line { stroke: var(--ink-soft); stroke-width: 1.5; stroke-dasharray: 4 3; }
  .dist-marker text { fill: var(--ink-soft); font-weight: 600; }
  .dist-table { margin-top: 0.5rem; font-size: 0.85rem; }
  .dist-table summary { cursor: pointer; color: var(--accent); }
  .dist-table table { border-collapse: collapse; margin-top: 0.5rem; min-width: 16rem; }
  .dist-table th, .dist-table td { text-align: left; padding: 0.3rem 0.75rem 0.3rem 0; border-bottom: 1px solid var(--border); color: var(--ink-soft); }
  .dist-table th { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  .dist-table .num { text-align: right; font-family: var(--font-display); }
  .dist-total td { font-weight: 600; color: var(--ink); }
  .dist-source { font-size: 0.8rem; color: var(--muted); margin: 0.5rem 0 0; line-height: 1.5; }
</style>
