---
/**
 * Dual sister-site teaser. Promotes asylumstats.co.uk + ukelections.co.uk
 * from UK Demographics.
 *
 * Two parallel cards, each with eyebrow / headline / 3 key stats / CTA.
 * Stacks on mobile.
 *
 * Update the per-site stats here when the headline numbers change on
 * either sister site.
 */

// asylumstats.co.uk: fiscal lens on asylum accommodation
const AS_DAILY_COST_GBP = 5_770_000;
const AS_PER_TAXPAYER_MIN_GBP = 155;
const AS_TEN_YEAR_GBP = 15_300_000_000;

// ukelections.co.uk: election forecasting + per-constituency outlook
const UKE_COUNCILS = 156;
const UKE_PCONS = 650;
const UKE_BACKTEST_ACC = "82.7%";

function fmtGbp(n: number) {
  if (n >= 1_000_000_000) return `£${(n / 1_000_000_000).toFixed(1)}B`;
  if (n >= 1_000_000) return `£${(n / 1_000_000).toFixed(2)}M`;
  return `£${n.toLocaleString("en-GB")}`;
}
---

<section class="sister-teaser shell" aria-labelledby="sister-teaser-title">
  <div class="st-head">
    <span class="st-eyebrow">Sister sites</span>
    <h2 class="st-title" id="sister-teaser-title">
      One model, three views: demographics, elections, fiscal cost
    </h2>
    <p class="st-desc">
      UK Demographics tracks the population change. Two sister sites read
      the same government data through different lenses. Follow all three
      for the full picture.
    </p>
  </div>

  <div class="st-pair">
    <!-- ukelections.co.uk -->
    <article class="st-card st-card--uke">
      <header class="st-card-head">
        <span class="st-card-tag">ukelections.co.uk</span>
        <h3 class="st-card-title">Forecast every council and constituency</h3>
        <p class="st-card-desc">
          Hamilton-Perry-anchored election model trained on demographic
          composition. Per-ward and per-constituency outlook for England,
          Wales, Scotland and Northern Ireland.
        </p>
      </header>
      <ul class="st-card-stats">
        <li>
          <span class="st-card-stat-value">{UKE_COUNCILS}</span>
          <span class="st-card-stat-label">councils with forecasts</span>
        </li>
        <li>
          <span class="st-card-stat-value">{UKE_PCONS}</span>
          <span class="st-card-stat-label">Westminster constituencies</span>
        </li>
        <li>
          <span class="st-card-stat-value">{UKE_BACKTEST_ACC}</span>
          <span class="st-card-stat-label">backtest accuracy</span>
        </li>
      </ul>
      <a
        href="https://ukelections.co.uk"
        class="st-card-cta"
        target="_blank"
        rel="noopener"
      >
        Open ukelections.co.uk &rarr;
      </a>
    </article>

    <!-- asylumstats.co.uk -->
    <article class="st-card st-card--as">
      <header class="st-card-head">
        <span class="st-card-tag">asylumstats.co.uk</span>
        <h3 class="st-card-title">Where the money goes</h3>
        <p class="st-card-desc">
          The fiscal bill for asylum accommodation. Home Office contracts,
          per-taxpayer cost, true-cost breakdown across hotels, dispersed
          accommodation, processing and local authority grants.
        </p>
      </header>
      <ul class="st-card-stats">
        <li>
          <span class="st-card-stat-value">{fmtGbp(AS_DAILY_COST_GBP)}</span>
          <span class="st-card-stat-label">per day, accommodation</span>
        </li>
        <li>
          <span class="st-card-stat-value">£{AS_PER_TAXPAYER_MIN_GBP}+</span>
          <span class="st-card-stat-label">per taxpayer per year</span>
        </li>
        <li>
          <span class="st-card-stat-value">{fmtGbp(AS_TEN_YEAR_GBP)}</span>
          <span class="st-card-stat-label">NAO 10-year forecast</span>
        </li>
      </ul>
      <a
        href="https://asylumstats.co.uk"
        class="st-card-cta"
        target="_blank"
        rel="noopener"
      >
        Open asylumstats.co.uk &rarr;
      </a>
    </article>
  </div>
</section>

<style>
  .sister-teaser {
    margin-top: var(--space-2xl);
    padding: var(--space-xl) 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--accent-2) 4%, transparent) 0%,
      color-mix(in srgb, var(--accent-3) 3%, transparent) 100%
    );
  }

  .st-head { max-width: 760px; margin-bottom: var(--space-lg); }
  .st-eyebrow {
    display: inline-block;
    padding: 0.3rem 0.65rem;
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--ink-soft);
    background: var(--panel-soft);
    border: 1px solid var(--border);
    border-radius: 999px;
    margin-bottom: 0.6rem;
  }
  .st-title {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 800;
    color: var(--ink);
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .st-desc {
    color: var(--muted);
    font-size: var(--text-body);
    line-height: 1.55;
    margin: 0;
  }

  .st-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }

  .st-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: var(--space-lg);
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-soft);
    transition: transform 180ms, box-shadow 180ms, border-color 180ms;
  }
  .st-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }
  .st-card--uke {
    border-left: 4px solid var(--accent-2);
  }
  .st-card--uke:hover {
    border-color: color-mix(in srgb, var(--accent-2) 35%, var(--border));
    border-left-color: var(--accent-2);
  }
  .st-card--as {
    border-left: 4px solid var(--accent-3);
  }
  .st-card--as:hover {
    border-color: color-mix(in srgb, var(--accent-3) 35%, var(--border));
    border-left-color: var(--accent-3);
  }

  .st-card-head {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .st-card-tag {
    align-self: flex-start;
    font-family: var(--font-display);
    font-size: var(--text-eyebrow);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    color: var(--ink);
    background: var(--panel-soft);
    border: 1px solid var(--border);
  }
  .st-card--uke .st-card-tag { color: var(--accent-2); border-color: color-mix(in srgb, var(--accent-2) 35%, transparent); }
  .st-card--as  .st-card-tag { color: var(--accent-3); border-color: color-mix(in srgb, var(--accent-3) 35%, transparent); }

  .st-card-title {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 800;
    color: var(--ink);
    margin: 0;
    line-height: 1.25;
  }
  .st-card-desc {
    color: var(--muted);
    font-size: var(--text-small);
    line-height: 1.55;
    margin: 0;
  }

  .st-card-stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xs);
  }
  .st-card-stats li {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.6rem 0.7rem;
    background: var(--panel-soft);
    border: 1px solid var(--border);
    border-radius: 10px;
  }
  .st-card-stat-value {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    line-height: 1.05;
  }
  .st-card--uke .st-card-stat-value { color: var(--accent-2); }
  .st-card--as  .st-card-stat-value { color: var(--accent-3); }
  .st-card-stat-label {
    font-size: 0.72rem;
    color: var(--muted);
    line-height: 1.3;
  }

  .st-card-cta {
    align-self: flex-start;
    padding: 0.7rem 1.1rem;
    font-size: var(--text-small);
    font-weight: 700;
    color: var(--ink);
    background: var(--panel-soft);
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
    transition: background 180ms, color 180ms, border-color 180ms, transform 180ms;
  }
  .st-card--uke .st-card-cta:hover {
    background: var(--accent-2);
    color: var(--bg);
    border-color: var(--accent-2);
  }
  .st-card--as .st-card-cta:hover {
    background: var(--accent-3);
    color: var(--bg);
    border-color: var(--accent-3);
  }

  @media (max-width: 760px) {
    .st-pair { grid-template-columns: 1fr; }
    .st-card-stats { grid-template-columns: repeat(3, 1fr); gap: 0.4rem; }
    .st-card-stat-value { font-size: 1.05rem; }
  }
  @media (max-width: 420px) {
    .st-card-stats { grid-template-columns: 1fr 1fr; }
  }
</style>
