---
/**
 * Sister site cards for ukelections.co.uk and asylumstats.co.uk.
 *
 * This component used to carry three hardcoded statistics per site, maintained by
 * hand and last touched when they were written. By August 2026 half of them were
 * wrong: "£5.77M per day" is a retired asylum accommodation figure (the NAO number
 * is £4.9bn over ten years), "£155+ per taxpayer per year" was a mangling of
 * £155.38 per second, and "82.7% backtest accuracy" did not match UK Elections'
 * own published record, which moves nightly and cannot be mirrored by hand.
 *
 * A cross link does not need a statistic. It needs to say what the other site does
 * and get out of the way, and it must never quote a number this repo cannot check.
 * If these cards ever carry figures again, they read them from a shared feed rather
 * than from constants in this file.
 *
 * Each card takes the sister site's own accent as a top rule, which is the estate
 * brand system's identity device: the accent triple is the only thing that varies
 * between the five sites.
 */

type Sister = {
  domain: string;
  name: string;
  accent: string;
  blurb: string;
  mark: "ballot" | "columns" | "ledger";
};

const SISTERS: Sister[] = [
  {
    domain: "ukelections.co.uk",
    name: "UK Elections",
    accent: "#6b5334",
    blurb:
      "Council by-elections and Westminster seats: results as they are declared, a forecast for each contest, and the record of how those forecasts actually did.",
    mark: "ballot"
  },
  {
    domain: "asylumstats.co.uk",
    name: "Asylum Stats",
    accent: "#2f5773",
    blurb:
      "Home Office asylum statistics by local authority: who is supported where, on what basis, and how each area compares with the rest of the country.",
    mark: "columns"
  },
  {
    domain: "aidoge.co.uk",
    name: "AI DOGE",
    accent: "#1c6e8a",
    blurb:
      "Council spending on AI DOGE: every payment a council has published, searchable by supplier and category, for every English and Scottish principal council.",
    mark: "ledger"
  }
];
---

<section class="sister-teaser shell" aria-labelledby="sister-teaser-title">
  <div class="st-head">
    <span class="st-eyebrow">Sister sites</span>
    <h2 class="st-title" id="sister-teaser-title">The same places, seen three more ways</h2>
    <p class="st-desc">
      UK Demographics projects the population. Three sister sites take the same local
      authorities and ask different questions of them, from government releases and,
      for AI DOGE, each council's own published spending.
    </p>
  </div>

  <div class="st-pair">
    {SISTERS.map((s) => (
      <a class="st-card" href={`https://${s.domain}`} target="_blank" rel="noopener" style={`--st-accent: ${s.accent}`}>
        <span class="st-mark" aria-hidden="true">
          {s.mark === "ballot" ? (
            <svg width="30" height="30" viewBox="0 0 64 64">
              <rect x="8" y="6" width="48" height="52" rx="3" fill="var(--st-accent)" opacity="0.24" />
              <path d="M22 22 L42 42 M42 22 L22 42" stroke="var(--st-accent)" stroke-width="7" stroke-linecap="square" fill="none" />
            </svg>
          ) : s.mark === "columns" ? (
            <svg width="30" height="30" viewBox="0 0 64 64">
              <rect x="10" y="26" width="18" height="34" fill="var(--st-accent)" />
              <rect x="36" y="6" width="18" height="54" fill="var(--st-accent)" opacity="0.45" />
            </svg>
          ) : (
            <svg width="30" height="30" viewBox="0 0 64 64">
              <rect x="10" y="6" width="44" height="52" rx="3" fill="var(--st-accent)" opacity="0.18" />
              <path d="M18 20 H46 M18 32 H46 M18 44 H34" stroke="var(--st-accent)" stroke-width="5" stroke-linecap="round" />
            </svg>
          )}
        </span>
        <span class="st-name">{s.name}</span>
        <span class="st-domain">{s.domain}</span>
        <span class="st-blurb">{s.blurb}</span>
        <span class="st-cta">Open <span aria-hidden="true">&rarr;</span></span>
      </a>
    ))}
  </div>
</section>

<style>
  .sister-teaser {
    margin-top: var(--space-2xl);
    padding: var(--space-xl) 0 var(--space-2xl);
    border-top: 1px solid var(--border);
  }

  .st-head { max-width: 62ch; margin-bottom: var(--space-lg); }
  .st-eyebrow {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .st-title {
    margin: 0.35rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.04em;
  }
  .st-desc { margin: 0.6rem 0 0; color: var(--text-muted); line-height: 1.7; }

  .st-pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1rem;
  }

  .st-card {
    display: grid;
    gap: 0.55rem;
    padding: 1.4rem 1.5rem 1.5rem;
    border: 1px solid var(--border);
    border-top: 3px solid var(--st-accent);
    border-radius: var(--radius);
    background: var(--bg-card);
    box-shadow: var(--shadow-soft);
    text-decoration: none;
    color: inherit;
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }
  .st-card:hover,
  .st-card:focus-visible {
    border-color: var(--border-strong);
    border-top-color: var(--st-accent);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }

  .st-mark { display: block; margin-bottom: 0.2rem; }
  .st-name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .st-domain {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--text-faint);
  }
  .st-blurb {
    margin-top: 0.35rem;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }
  .st-cta {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--st-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .st-card { transition: none; }
    .st-card:hover, .st-card:focus-visible { transform: none; }
  }
</style>
