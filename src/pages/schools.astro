---
import BaseLayout from "../layouts/BaseLayout.astro";
import StatCard from "../components/StatCard.astro";
import { slugifyAreaName } from "../lib/site";
import schoolPressure from "../data/live/school-pressure.json";

const sp = schoolPressure as any;
const areasWithData = Object.entries(sp.areas)
  .filter(([_, d]: any) => d.dataAvailable)
  .map(([code, d]: any) => ({ code, ...d }))
  .sort((a, b) => (b.minorityPupilsPct ?? 0) - (a.minorityPupilsPct ?? 0));
---

<BaseLayout
  title="School demographic pressure"
  description={`School ethnic composition across ${areasWithData.length} local authorities. DfE School Census 2024/25 data with projected growth.`}
>
  <h1>School demographic pressure</h1>
  <p class="desc">DfE School Census 2024/25: pupil ethnic composition by local authority. {areasWithData.length} areas with school data. Sorted by minority pupil share (descending).</p>

  <div class="stat-card-row">
    <StatCard value={areasWithData.length.toString()} label="Areas with school data" accent="var(--accent)" />
    <StatCard value={areasWithData.filter(a => (a.minorityPupilsPct ?? 0) > 50).length.toString()} label="Minority-majority schools" accent="var(--coral)" />
    <StatCard value={areasWithData.filter(a => (a.ealDemandGrowthPp ?? 0) > 10).length.toString()} label="Areas with 10pp+ English-as-Additional-Language growth projected" accent="var(--accent-3)" />
  </div>
  <p class="caveat">EAL = English as Additional Language. White British pupils means pupils self-identified or recorded as White British in the DfE School Census.</p>

  <div class="area-table">
    <div class="area-table-header"><span>Area</span><span>White British pupils</span><span>Minority pupils</span><span>EAL growth</span><span>Total pupils</span></div>
    {areasWithData.slice(0, 50).map((a) => {
      const eal = a.ealDemandGrowthPp;
      const ealText = eal == null
        ? "-"
        : `${eal >= 0 ? "+" : ""}${eal.toFixed(1)}pp`;
      return (
        <a href={`/places/${slugifyAreaName(a.areaName)}/`} class="area-row">
          <span class="name">{a.areaName}</span>
          <span class="val">{a.wbiPupilsPct?.toFixed(1) ?? "-"}%</span>
          <span class="val accent">{a.minorityPupilsPct?.toFixed(1) ?? "-"}%</span>
          <span class="val warn">{ealText}</span>
          <span class="val muted">{a.totalPupils?.toLocaleString() ?? "-"}</span>
        </a>
      );
    })}
  </div>
  <a href="/places/" class="cta-link">Browse all areas &rarr;</a>
</BaseLayout>

<style>
  h1 { font-family: var(--font-display); font-size: 1.8rem; font-weight: 600; margin: 0 0 0.5rem; }
  .desc { color: var(--muted); font-size: 0.92rem; margin: 0 0 1.5rem; max-width: 700px; }
  .caveat { color: var(--muted); font-size: 0.78rem; margin: 0.5rem 0 1rem; max-width: 700px; line-height: 1.4; }
  .area-table { max-width: 800px; }
  .area-table-header { display: grid; grid-template-columns: 1fr 80px 80px 90px 100px; padding: 0.5rem 0.75rem; font-size: 0.78rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); border-bottom: 1px solid var(--border-strong); }
  .area-row { display: grid; grid-template-columns: 1fr 80px 80px 90px 100px; align-items: center; padding: 0.5rem 0.75rem; text-decoration: none; color: var(--ink); border-bottom: 1px solid var(--border); transition: background 120ms; }
  .area-row:hover { background: color-mix(in srgb, var(--accent) 8%, transparent); }
  .name { font-weight: 600; font-size: 0.88rem; }
  .val { font-family: var(--font-display); font-size: 0.85rem; font-weight: 600; }
  .val.accent { color: var(--accent); }
  .val.warn { color: var(--accent-3); }
  .val.muted { color: var(--muted); font-weight: 400; }
  .cta-link { display: inline-block; margin-top: 1.25rem; font-size: 0.92rem; font-weight: 600; color: var(--accent); text-decoration: none; }
  @media (max-width: 640px) { .area-table-header, .area-row { grid-template-columns: 1fr 70px 70px; } .area-row .val:nth-child(n+4) { display: none; } .area-table-header span:nth-child(n+4) { display: none; } }
</style>
