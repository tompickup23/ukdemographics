---
import BaseLayout from "../layouts/BaseLayout.astro";
import DataFreshness from "../components/DataFreshness.astro";
import ShareButton from "../components/ShareButton.astro";
import SisterSiteTeaser from "../components/SisterSiteTeaser.astro";
import StatCard from "../components/StatCard.astro";
import { getSignificantDemographicShifts, getEthnicProjection } from "../lib/ethnic-projections";
import rawProjections from "../data/live/ethnic-projections.json";
import { slugifyAreaName, SITE_URL, getPublicPlaceAreas } from "../lib/site";
import { getCollection } from "astro:content";

const projData = rawProjections as any;
const publicAreas = getPublicPlaceAreas();
const totalAreas = publicAreas.length;

function fmtInt(n: number) { return n.toLocaleString("en-GB"); }
function fmtPct1(n: number) { return `${n.toFixed(1)}%`; }

// Demographic modelling data
const demographicShifts = getSignificantDemographicShifts(2051);
const areasBelow50 = demographicShifts.length;
const demographicShifts2061 = getSignificantDemographicShifts(2061);
const areasBelow50by2061 = demographicShifts2061.length;

// Dynamic demographic counts
// ethnic-projections.json carries two authorities twice, under both their
// retired and their current ONS codes: Barnsley as E08000016 and E08000038,
// Sheffield as E08000019 and E08000039, with identical populations. Only the
// current codes are in the public area registry, so only one page renders for
// each, but keying off the raw projection object double-counted 801,000 people
// in every national aggregate on this page. The registry is the canonical set.
const publicAreaCodes = new Set(publicAreas.map((a) => a.areaCode));
const allAreaCodes = Object.keys(projData.areas).filter((c) => publicAreaCodes.has(c));
const muslimMajority2051 = allAreaCodes.filter(code => {
  const mp = projData.areas[code]?.muslimPct2051;
  return mp && mp > 50;
}).length;
const foreignBornMajority2051 = allAreaCodes.filter(code => {
  const fb = projData.areas[code]?.nativity?.["2051"]?.foreignBornPct;
  return fb && fb > 50;
}).length;

// National population-weighted White British shares, computed from projData
// (weighted by 2021 LA population throughout for consistency).
const natAgg = (() => {
  let totalPop = 0;
  let wb2011 = 0, wb2021 = 0, wb2051 = 0, wb2061 = 0;
  let n2051 = 0, n2061 = 0;
  for (const code of allAreaCodes) {
    const a = projData.areas[code];
    const pop = a?.current?.total_population ?? 0;
    if (!pop) continue;
    totalPop += pop;
    wb2011 += (a?.baseline?.groups?.white_british ?? 0) * pop;
    wb2021 += (a?.current?.groups?.white_british ?? 0) * pop;
    const p51 = a?.projections?.["2051"]?.white_british;
    const p61 = a?.projections?.["2061"]?.white_british;
    if (p51 != null) { wb2051 += p51 * pop; n2051++; }
    if (p61 != null) { wb2061 += p61 * pop; n2061++; }
  }
  return {
    pop: totalPop,
    wb2011: totalPop > 0 ? wb2011 / totalPop : 0,
    wb2021: totalPop > 0 ? wb2021 / totalPop : 0,
    wb2051: totalPop > 0 ? wb2051 / totalPop : 0,
    wb2061: totalPop > 0 ? wb2061 / totalPop : 0,
    n2051,
    n2061,
  };
})();
const natWb2011 = natAgg.wb2011;
const natWb2021 = natAgg.wb2021;
const natWb2051 = natAgg.wb2051;
const natWb2061 = natAgg.wb2061;
const natCoverage2061Pct = totalAreas > 0 ? (natAgg.n2061 / totalAreas) * 100 : 0;

// Regional summary
const regionCounts = new Map<string, { count: number; avgWbi2021: number; sumPop: number }>();
for (const area of publicAreas) {
  const r = regionCounts.get(area.regionName) ?? { count: 0, avgWbi2021: 0, sumPop: 0 };
  r.count++;
  r.avgWbi2021 += (area.wbiPct2021 ?? 0) * (area.population ?? 0);
  r.sumPop += area.population ?? 0;
  regionCounts.set(area.regionName, r);
}
const topRegions = [...regionCounts.entries()]
  .map(([name, r]) => ({ name, count: r.count, avgWbi: r.sumPop > 0 ? (r.avgWbi2021 / r.sumPop) : 0, pop: r.sumPop }))
  .filter(r => r.name !== "Unknown")
  .sort((a, b) => a.avgWbi - b.avgWbi)
  .slice(0, 6);

// Top areas by largest projected White British share decline 2021 to 2041.
// Bars encode the projected change (in percentage points), not the level.
const topChangingAreas = publicAreas
  .filter((a) => a.wbiPct2021 != null && a.wbiPct2041 != null)
  .map((a) => ({ ...a, changePp: a.wbiPct2041! - a.wbiPct2021! }))
  .sort((a, b) => a.changePp - b.changePp)
  .slice(0, 10);
const topChangingMaxAbsPp = topChangingAreas.length > 0
  ? Math.max(...topChangingAreas.map((a) => Math.abs(a.changePp)))
  : 1;

// The year an area is projected to fall below a 50% White British share, interpolated
// between projection decades. A date is a thing a reader can picture; a percentage point
// change is not. Returns 0 for areas already below half and null for areas the model
// does not take across the line inside its horizon.
function crossingYear(a: any): number | null {
  const pts: Array<[number, number]> = [];
  const now = a?.current?.groups?.white_british;
  if (now == null) return null;
  pts.push([2021, now]);
  for (const y of [2031, 2041, 2051, 2061]) {
    const v = a?.projections?.[String(y)]?.white_british;
    if (v != null) pts.push([y, v]);
  }
  if (now < 50) return 0;
  for (let i = 0; i < pts.length - 1; i++) {
    const [y1, v1] = pts[i];
    const [y2, v2] = pts[i + 1];
    if (v1 >= 50 && v2 < 50) return Math.round(y1 + ((v1 - 50) / (v1 - v2)) * (y2 - y1));
  }
  return null;
}

// Only areas with a clear majority today. An area sitting at 52% in 2021 "crosses in
// 2023" purely because it started next to the line, which is inside the model's own
// 1.56pp error and is not a projection worth printing. Requiring a 60% base means the
// year is carried by the trend rather than by the starting position, and it matches the
// published finding, whose interest is the areas that are comfortably majority now.
const CROSSING_MIN_BASE_PCT = 60;
const crossingSoon = publicAreas
  .map((area) => {
    const rec = projData.areas[area.areaCode];
    return { area, year: crossingYear(rec), now: rec?.current?.groups?.white_british ?? null };
  })
  .filter((r) => r.year !== null && r.now != null && r.now >= CROSSING_MIN_BASE_PCT)
  .sort((a, b) => (a.year as number) - (b.year as number))
  .slice(0, 8);

const crossingAlready = publicAreas.filter((area) => {
  const rec = projData.areas[area.areaCode];
  return crossingYear(rec) === 0;
}).length;

// Get latest findings
const allFindings = await getCollection("findings");
const topFindings = allFindings
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

function findingLabel(verdict: string): string {
  const labels: Record<string, string> = {
    critical: "INVESTIGATION",
    alert: "FINDING",
    info: "ANALYSIS",
    resolved: "RESOLVED",
  };
  return labels[verdict] ?? "FINDING";
}

function findingColor(verdict: string): string {
  const colors: Record<string, string> = {
    critical: "var(--coral)",
    alert: "var(--accent-3)",
    info: "var(--accent)",
    resolved: "var(--accent-2)",
  };
  return colors[verdict] ?? "var(--accent)";
}
---

<BaseLayout
  title="UK Demographics, population projections for every community"
  description={`${fmtInt(totalAreas)} local authorities. Ethnic projections to 2061. Census 2021 to the future. Every figure sourced from ONS data.`}
>
  <!-- HERO -->
  <section class="hero-section">
    <div class="hero-inner">
      <div class="hero-main">
      <div class="hero-eyebrow">Census 2021 projected to 2061 &middot; model v8.0</div>
      <h1 class="hero-headline">What will your area look like in 2051?</h1>
      <p class="hero-subline">
        Put in a postcode and get the whole picture for that community: the ethnic
        projection to 2061, who is arriving and why, school and housing pressure, care
        and health demand, and the constituency it sits in. Twenty three datasets, one
        page, every figure sourced.
      </p>

      <div class="hero-search">
        <input
          type="search"
          id="area-search"
          placeholder="Enter a postcode, council or constituency"
          autocomplete="off"
          spellcheck="false"
          aria-label="Search for a local authority"
        />
        <div class="lookup-results" id="area-results" hidden></div>
      </div>

      <ul class="hero-trust">
        <li><strong>{fmtInt(totalAreas)}</strong> local authorities</li>
        <li><strong>631</strong> constituencies</li>
        <li><strong>23</strong> datasets per area</li>
        <li>Free to reuse with attribution</li>
      </ul>

      <a class="hero-source" href="/methodology/">
        Scored against Census 2021 before publication: 1.56pp average error, +0.05pp bias, 285 areas &rarr;
      </a>
      </div>

      <aside class="hero-panel">
        <span class="hero-panel-eyebrow">England and Wales</span>
        <h2 class="hero-panel-title">White British share of population</h2>
        <div class="hero-traj">
          {[
            { yr: "2011", v: natWb2011, kind: "past", gloss: "four in five" },
            { yr: "2021", v: natWb2021, kind: "now", gloss: "three in four" },
            { yr: "2051", v: natWb2051, kind: "proj", gloss: "just over half" },
            { yr: "2061", v: natWb2061, kind: "proj-pale", gloss: "under two in five" }
          ].map((r) => (
            <div class="hero-traj-row">
              <span class="hero-traj-year">{r.yr}</span>
              <span class="hero-traj-track">
                <span class={`hero-traj-fill hero-traj-fill--${r.kind}`} style={`width: ${r.v.toFixed(1)}%`}></span>
              </span>
              <span class="hero-traj-pct">{fmtPct1(r.v)}</span>
              <span class="hero-traj-gloss">{r.gloss}</span>
            </div>
          ))}
        </div>
        <div class="hero-traj-key">
          <span><i class="hero-key-sw hero-key-sw--now"></i>Census</span>
          <span><i class="hero-key-sw hero-key-sw--proj"></i>Projected</span>
        </div>
        <p class="hero-panel-note">
          2061 covers {natAgg.n2061} of {fmtInt(totalAreas)} areas and is shown as illustrative.
          Population-weighted across every area with a 2021 base.
        </p>
      </aside>
    </div>
  </section>

  <!-- ═══ TOP FINDINGS ═══ -->
  {topFindings.length > 0 && (
    <section class="findings-strip shell">
      <h2 class="strip-title">Latest research</h2>
      <div class="findings-row">
        {topFindings.map((finding) => (
          <a href={`/findings/${finding.id.replace(/\.md$/, "")}/`} class="finding-strip-card">
            <span class="fsc-verdict" style={`color: ${findingColor(finding.data.verdict)}`}>{findingLabel(finding.data.verdict)}</span>
            <span class="fsc-stat" style={`color: ${findingColor(finding.data.verdict)}`}>{finding.data.stat_value}</span>
            <span class="fsc-headline">{finding.data.headline}</span>
            <span class="fsc-cta">Read more &rarr;</span>
          </a>
        ))}
      </div>
      <a href="/findings/" class="cta-link">All {allFindings.length} findings &rarr;</a>
    </section>
  )}

  <!-- IMPACT STRIP -->
  <section class="impact-strip shell" aria-label="Headline demographic impact">
    <div class="impact-strip-inner">
      <div class="impact-item impact-item--hero">
        <span class="impact-number">{fmtPct1(natWb2021)} &rarr; {fmtPct1(natWb2051)}</span>
        <span class="impact-label">White British share, 2021 &rarr; 2051</span>
        <span class="impact-context">Population-weighted across {fmtInt(totalAreas)} local authorities. Observed Census 2021 vs Hamilton-Perry projection.</span>
        <span class="impact-calc">Illustrative 2061: {fmtPct1(natWb2061)} ({natAgg.n2061} of {totalAreas} areas have a 2061 projection). Full trajectory in the model below.</span>
      </div>
      <div class="impact-item">
        <span class="impact-number">{areasBelow50}</span>
        <span class="impact-label">areas below 50% White British by 2051</span>
        <span class="impact-context">{areasBelow50by2061} by 2061. Click any area for its 2011 to 2061 trajectory.</span>
      </div>
      <div class="impact-item">
        <span class="impact-number">{foreignBornMajority2051}</span>
        <span class="impact-label">areas projected foreign-born majority by 2051</span>
        <span class="impact-context">{muslimMajority2051} projected Muslim majority by 2051.</span>
      </div>
    </div>
    <p class="impact-source">Census 2011 and 2021 observed. 2051 and 2061 projected by Hamilton-Perry CCR model, 1,000 Monte Carlo simulations. The model was fitted on Census 2001 to 2011 and scored against Census 2021: mean absolute error 1.56 percentage points per decade, bias +0.05 points across 285 areas. Areas where the model diverged are withheld. <a href="/methodology/">Full methodology &rarr;</a></p>
  </section>

  <!-- ═══ DEMOGRAPHIC PROJECTIONS ═══ -->
  <section class="demo-section shell" id="demographics">
    <div class="demo-inner">
      <span class="chip accent" style="margin-bottom: 0.75rem;">Hamilton-Perry model, Census-verified</span>
      <h2 class="section-title">National ethnic composition trajectory</h2>
      <p class="section-desc" style="max-width: 700px;">
        The ONS does not project ethnic composition at local authority level. This model does.
        {fmtInt(totalAreas)} local authorities. Census 2011 and 2021 observed data. Hamilton-Perry CCR methodology.
        1,000 Monte Carlo simulations. Every ratio traced to Census observations.
      </p>

      <!-- Key stats grid -->
      <div class="stat-card-row" style="margin-top: 1.5rem;">
        <StatCard
          value={areasBelow50.toString()}
          label="areas WBI under 50% by 2051"
          accent="var(--coral)"
        />
        <StatCard
          value={areasBelow50by2061.toString()}
          label="areas WBI under 50% by 2061"
          accent="var(--accent-3)"
        />
        <StatCard
          value={muslimMajority2051.toString()}
          label="areas projected Muslim majority by 2051"
          accent="var(--accent-3)"
        />
        <StatCard
          value={foreignBornMajority2051.toString()}
          label="areas projected foreign-born majority by 2051"
          accent="var(--accent)"
        />
      </div>

      <!-- The years these areas cross 50%. A date is a thing a reader can picture; a
           percentage point change is not, so the year leads and the change is dropped. -->
      <div class="cross-section">
        <h3 class="cross-title">The years these areas cross 50%</h3>
        <p class="cross-desc">
          Areas that are comfortably majority White British today, and the year the projection
          takes each of them below half. Interpolated between projection decades, so the years
          are approximate. Areas already close to the line are left out: their crossing year is
          carried by where they started rather than by the trend, and it sits inside the model's
          own error. {crossingAlready} areas are already below a majority.
        </p>
        <div class="cross-table">
          <div class="cross-head">
            <span>Area</span>
            <span>Region</span>
            <span class="cross-num">Today</span>
            <span>2021 to 2041</span>
            <span class="cross-num">Crosses 50%</span>
          </div>
          {crossingSoon.map((r) => (
            <a href={`/places/${slugifyAreaName(r.area.areaName)}/`} class="cross-row">
              <span class="cross-name">{r.area.areaName}</span>
              <span class="cross-region">{r.area.regionName}</span>
              <span class="cross-num cross-today">{fmtPct1(r.now as number)}</span>
              <span class="cross-axis">
                <span class="cross-axis-line"></span>
                <span
                  class="cross-axis-dot"
                  style={`left: ${Math.max(0, Math.min(100, (((r.year as number) - 2021) / 20) * 100)).toFixed(1)}%`}
                ></span>
              </span>
              <span class="cross-num cross-year">{r.year}</span>
            </a>
          ))}
        </div>
        <p class="cross-note">
          The marker sits on a 2021 to 2041 axis. Source: Census 2021 (ONS) projected with
          Hamilton-Perry v8.0, mean absolute error 1.56pp per decade.
        </p>
      </div>

      <div class="chip-row" style="margin-top: 1.5rem;">
        <a href="/findings/" class="cta-btn cta-btn--primary">See the research</a>
        <a href="/national/" class="cta-btn cta-btn--secondary">National demographic outlook</a>
        <a href="/methodology/" class="cta-btn cta-btn--ghost">Methodology</a>
      </div>
    </div>
  </section>

  <!-- YOUR AREA IN 2051 -->
  <section class="future-section shell" id="your-area">
    <div class="future-inner">
      <span class="chip accent" style="margin-bottom: 0.5rem;">Explore the data</span>
      <h2 class="section-title">What does your area look like in 2051?</h2>
      <p class="section-desc" style="max-width: 600px;">
        {fmtInt(totalAreas)} local authority profiles. Demographic projections to 2061, religion, nativity, shift-share analysis, school data, economic profiles.
      </p>
      <div class="future-search">
        <input
          type="search"
          id="future-search"
          placeholder="Type your council name..."
          autocomplete="off"
          spellcheck="false"
          aria-label="Search for your area"
        />
        <div class="future-results" id="future-results" hidden></div>
      </div>
      <div class="future-preview" id="future-preview" hidden>
        <div class="future-card">
          <h3 id="future-area-name"></h3>
          <div class="future-stats">
            <div class="future-stat">
              <span class="future-stat-label">Population</span>
              <span class="future-stat-value" id="future-pop"></span>
            </div>
            <div class="future-stat">
              <span class="future-stat-label">White British 2021</span>
              <span class="future-stat-value" id="future-wb-now"></span>
            </div>
            <div class="future-stat">
              <span class="future-stat-label">White British 2051</span>
              <span class="future-stat-value" id="future-wb-2051"></span>
            </div>
          </div>
          <a class="cta-btn cta-btn--primary" id="future-link" href="/places/">See the full profile &rarr;</a>
        </div>
      </div>
      <a href="/places/" class="cta-link" style="margin-top: 1rem;">Browse all {fmtInt(totalAreas)} areas &rarr;</a>
    </div>
  </section>

  <!-- ═══ REGIONAL OVERVIEW ═══ -->
  {topRegions.length > 0 && (
    <section class="pressure-section shell" id="regional">
      <h2 class="section-title">Most diverse regions</h2>
      <p class="section-desc">
        Regional variation in ethnic composition. Sorted by lowest population-weighted White British share.
      </p>
      <div class="region-grid">
        {topRegions.map((region) => (
          <div class="region-card">
            <span class="region-name">{region.name}</span>
            <span class="region-stat">{region.avgWbi.toFixed(1)}%</span>
            <span class="region-rate">WBI (pop-weighted) &middot; {region.count} areas</span>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- ═══ SISTER SITE (asylumstats) ═══ -->
  <SisterSiteTeaser />

  <!-- CTA STRIP -->
  <section class="cta-section shell">
    <div class="cta-inner">
      <h2>Every projection sourced. Every figure checked.</h2>
      <p>Census 2021 observed data. Hamilton-Perry methodology. Click any figure to trace it back to the ONS.</p>
      <div class="cta-buttons">
        <a href="/places/" class="cta-btn cta-btn--primary">Look up your area</a>
        <a href="/findings/" class="cta-btn cta-btn--secondary">Read the research</a>
        <a href="/sources/" class="cta-btn cta-btn--ghost">Check the sources</a>
      </div>
      <div style="margin-top: 1rem;">
        <ShareButton
          url={SITE_URL}
          title="UK Demographics, population projections for every community"
          text={`${fmtInt(totalAreas)} local authorities. Ethnic projections to 2061. See the data: ${SITE_URL}`}
          compact
        />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const searchInput = document.getElementById("area-search") as HTMLInputElement | null;
  const resultsContainer = document.getElementById("area-results");

  if (searchInput && resultsContainer) {
    let areas: Array<{ areaCode: string; areaName: string; regionName: string; wbiPct2021?: number; population?: number }> = [];

    fetch("/search-index.json")
      .then((r) => r.json())
      .then((data) => {
        if (Array.isArray(data)) {
          areas = data;
        } else if (data.areas) {
          areas = data.areas;
        }
      })
      .catch(() => {});

    const postcodeRegex = /^[A-Z]{1,2}\d[A-Z\d]?\s*\d[A-Z]{2}$/i;
    const partialPostcodeRegex = /^[A-Z]{1,2}\d[A-Z\d]?\s*\d/i;
    let postcodeTimeout: ReturnType<typeof setTimeout> | null = null;

    function slugify(name: string) {
      return name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
    }

    function showLookupMessage(text: string) {
      if (!resultsContainer) return;
      resultsContainer.textContent = "";
      const div = document.createElement("div");
      div.className = "lookup-result";
      div.style.opacity = "0.5";
      div.textContent = text;
      resultsContainer.appendChild(div);
    }

    function showPostcodeResult(areaName: string, laCode: string, postcode: string) {
      resultsContainer!.innerHTML = "";
      resultsContainer!.hidden = false;
      const matchedArea = areas.find((a) => a.areaCode === laCode);
      const link = document.createElement("a");
      link.href = `/places/${slugify(areaName)}/`;
      link.className = "lookup-result";
      const strong = document.createElement("strong");
      strong.textContent = `${postcode.toUpperCase()} → ${areaName}`;
      const span = document.createElement("span");
      span.textContent = matchedArea
        ? `${matchedArea.regionName} · View demographic projections`
        : "View demographic projections";
      link.appendChild(strong);
      link.appendChild(span);
      resultsContainer!.appendChild(link);
    }

    searchInput.addEventListener("input", () => {
      const query = searchInput.value.trim();
      const queryLower = query.toLowerCase();
      resultsContainer!.innerHTML = "";

      if (query.length < 2) {
        resultsContainer!.hidden = true;
        return;
      }

      if (postcodeRegex.test(query) || (partialPostcodeRegex.test(query) && query.length >= 5)) {
        resultsContainer!.hidden = false;
        showLookupMessage("Looking up postcode...");

        if (postcodeTimeout) clearTimeout(postcodeTimeout);
        postcodeTimeout = setTimeout(() => {
          const clean = query.replace(/\s+/g, "").toUpperCase();
          fetch(`https://api.postcodes.io/postcodes/${clean}`)
            .then((r) => r.json())
            .then((data) => {
              if (data.status === 200 && data.result) {
                const adminDistrict = data.result.admin_district;
                const laCode = data.result.codes?.admin_district;
                if (adminDistrict) {
                  showPostcodeResult(adminDistrict, laCode, query);
                }
              } else {
                showLookupMessage("Postcode not found. Try an area name.");
              }
            })
            .catch(() => {
              showLookupMessage("Could not look up postcode.");
            });
        }, 300);
        return;
      }

      const matches = areas
        .filter((a) => a.areaName && a.areaName.toLowerCase().includes(queryLower))
        .slice(0, 8);

      if (matches.length === 0) {
        resultsContainer!.hidden = true;
        return;
      }

      resultsContainer!.hidden = false;
      for (const area of matches) {
        const link = document.createElement("a");
        link.href = `/places/${slugify(area.areaName)}/`;
        link.className = "lookup-result";
        const strong = document.createElement("strong");
        strong.textContent = area.areaName;
        const span = document.createElement("span");
        span.textContent = `${area.regionName} · View projections`;
        link.appendChild(strong);
        link.appendChild(span);
        resultsContainer!.appendChild(link);
      }
    });

    searchInput.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        resultsContainer!.hidden = true;
        searchInput.value = "";
      }
    });
  }

  // Future area search + preview
  const futureInput = document.getElementById("future-search") as HTMLInputElement | null;
  const futureResults = document.getElementById("future-results");
  const futurePreview = document.getElementById("future-preview");

  if (futureInput && futureResults && futurePreview) {
    let futureAreas: any[] = [];

    fetch("/search-index.json")
      .then((r) => r.json())
      .then((data) => {
        futureAreas = Array.isArray(data) ? data : data.areas ?? [];
      })
      .catch(() => {});

    futureInput.addEventListener("input", () => {
      const query = futureInput.value.trim().toLowerCase();
      futureResults.textContent = "";
      futurePreview.hidden = true;

      if (query.length < 2) {
        futureResults.hidden = true;
        return;
      }

      const matches = futureAreas
        .filter((a: any) => a.areaName && a.areaName.toLowerCase().includes(query))
        .slice(0, 6);

      if (matches.length === 0) {
        futureResults.hidden = true;
        return;
      }

      futureResults.hidden = false;
      for (const area of matches) {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "future-result-btn";
        btn.textContent = `${area.areaName} (${area.regionName})`;
        btn.addEventListener("click", () => {
          futureInput.value = area.areaName;
          futureResults.hidden = true;
          showFuturePreview(area);
        });
        futureResults.appendChild(btn);
      }
    });

    function showFuturePreview(area: any): void {
      if (!futurePreview) return;
      const nameEl = document.getElementById("future-area-name");
      const popEl = document.getElementById("future-pop");
      const wbNowEl = document.getElementById("future-wb-now");
      const wb2051El = document.getElementById("future-wb-2051");
      const linkEl = document.getElementById("future-link") as HTMLAnchorElement;

      if (nameEl) nameEl.textContent = area.areaName;
      if (popEl) popEl.textContent = area.population ? area.population.toLocaleString() : "n/a";
      if (wbNowEl) wbNowEl.textContent = area.wbiNow ? `${area.wbiNow}%` : (area.wbiPct2021 ? `${area.wbiPct2021}%` : "n/a");
      if (wb2051El) wb2051El.textContent = area.wbi2051 ? `${area.wbi2051}%` : "n/a";
      if (linkEl) linkEl.href = `/places/${area.areaName.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "")}/`;

      futurePreview.hidden = false;
    }
  }
</script>

