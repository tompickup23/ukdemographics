---
import { PROJECTION_DECADES, censusWhiteBritish2021, crossingDecade } from "../lib/crossing";
import BaseLayout from "../layouts/BaseLayout.astro";
import DataFreshness from "../components/DataFreshness.astro";
import ShareButton from "../components/ShareButton.astro";
import SisterSiteTeaser from "../components/SisterSiteTeaser.astro";
import StatCard from "../components/StatCard.astro";
import { getAreasBelowWhiteBritishMajority, getEthnicProjection } from "../lib/ethnic-projections";
import rawProjections from "../data/live/ethnic-projections.json";
import { slugifyAreaName, SITE_URL, getPublicPlaceAreas } from "../lib/site";
import { PLACE_COUNT, PCON_COUNT } from "../lib/coverage";
import { census2011WhiteBritish, census2021WhiteBritish } from "../lib/census-national";
import { nationalWhiteBritishAggregate } from "../lib/national-share";
import { getCollection } from "astro:content";
import { coveredSeries, MYE_SERIES_SOURCE_LINE } from "../lib/population-headline";

const projData = rawProjections as any;
const publicAreas = getPublicPlaceAreas();
const totalAreas = PLACE_COUNT;

function fmtInt(n: number) { return n.toLocaleString("en-GB"); }
function fmtPct1(n: number) { return `${n.toFixed(1)}%`; }

// Demographic modelling data. These cards are labelled "areas below 50% White
// British", which is a stock, so they count areas whose projection for the year
// is under 50%. They used to count threshold crossings, which is a flow: an area
// already under 50% at the 2021 Census has no crossing to record and so was
// left out of a count of areas under 50%. That published 60 for 2051 where the
// projections say 92, with Birmingham, Leicester, Luton, Slough, Manchester and
// Brent among the 33 omitted.
const below2051 = getAreasBelowWhiteBritishMajority(2051);
const areasBelow50 = below2051.count;
const below2061 = getAreasBelowWhiteBritishMajority(2061);
const areasBelow50by2061 = below2061.count;

// Dynamic demographic counts
// ethnic-projections.json used to carry two authorities twice, under both the
// codes ONS reissued in 2025 and the codes the Census 2021 model is built on:
// Barnsley as E08000016 and E08000038, Sheffield as E08000019 and E08000039.
// Every aggregate on this page counted their 801,000 people twice, and the
// filter below was written to stop it. It could never have done so: the
// registry it filters against is built from this same area map, so it excluded
// nothing. The duplicates are now folded out of the data itself by
// scripts/model/canonicalise_area_codes.mjs, and tests/area-codes.test.ts fails
// if one comes back. The filter is kept because the registry may one day
// exclude areas for reasons of its own, but it is not what fixed this.
const publicAreaCodes = new Set(publicAreas.map((a) => a.areaCode));
const allAreaCodes = Object.keys(projData.areas).filter((c) => publicAreaCodes.has(c));
const muslimMajority2051 = allAreaCodes.filter(code => {
  const mp = projData.areas[code]?.muslimPct2051;
  return mp && mp > 50;
}).length;
const foreignBornMajority2051 = allAreaCodes.filter(code => {
  const fb = projData.areas[code]?.nativity?.["2051"]?.foreignBornPct;
  return fb && fb > 50;
}).length;

// National population-weighted White British shares for the projected years, on the
// two rules set out in src/lib/national-share.ts: each year divides by the population
// of the areas that year covers, and a year counts for an area only where it is
// publishable for it. tests/majority-counts.test.ts checks the prose against it.
const natAgg = nationalWhiteBritishAggregate(allAreaCodes);
// Census years are observed, so each is weighted by its own population: 2011 is
// Census 2011 KS201EW for England and Wales on 2011 boundaries, 2021 the 318
// areas' Census 2021 TS021 counts. See src/lib/census-national.ts.
const census2011 = census2011WhiteBritish();
const census2021 = census2021WhiteBritish(allAreaCodes);
if (!census2011 || !census2021) throw new Error("Census White British totals missing; run scripts/build/rebase-census-groups.mjs");
const natWb2011 = census2011.pct;
const natWb2021 = census2021.pct;
const natWb2051 = natAgg.wb2051;
const natWb2061 = natAgg.wb2061;

// Population first (decision R359, 4 November 2026). The first chart and the first stat
// row are population change from the ONS mid-year estimates, summed over the same areas
// every other aggregate on this page uses. The site covers England and Wales, so the
// England-only row would not match the areas a reader can click into; the sum of the
// covered areas does, and tests/population-estimates.test.ts pins it to the workbook's
// own England and Wales row. coveredSeries throws if any area lacks any year.
const popSeries = coveredSeries(allAreaCodes);
const fmtSigned = (n: number) => `${n < 0 ? "−" : "+"}${fmtInt(Math.abs(n))}`;
const fmtSignedPct = (n: number) => `${n < 0 ? "−" : "+"}${Math.abs(n).toFixed(1)}%`;
const fmtMillions = (n: number) => `${(n / 1e6).toFixed(1)}m`;

// The line chart beside the search. One series, so no legend: the title names it. The
// axis does not start at zero, and its labels say where it starts. Ticks every two
// million on whole millions read from the data's own range.
const POP_W = 360, POP_H = 210, POP_L = 34, POP_R = 14, POP_T = 22, POP_B = 26;
const popMin = Math.floor(Math.min(...popSeries.points.map((p) => p.population)) / 2e6) * 2e6;
const popMax = Math.ceil(Math.max(...popSeries.points.map((p) => p.population)) / 2e6) * 2e6;
const popTicks = Array.from({ length: (popMax - popMin) / 2e6 + 1 }, (_, i) => popMin + i * 2e6);
const popX = (year: number) =>
  POP_L + ((year - popSeries.base.year) / (popSeries.latest.year - popSeries.base.year)) * (POP_W - POP_L - POP_R);
const popY = (v: number) => POP_T + (1 - (v - popMin) / (popMax - popMin)) * (POP_H - POP_T - POP_B);
const popPath = popSeries.points.map((p, i) => `${i ? "L" : "M"}${popX(p.year).toFixed(1)},${popY(p.population).toFixed(1)}`).join(" ");
const popCensusYear = 2021;
const popLabelled = popSeries.points.filter((p) => p.year === popSeries.base.year || p.year === popCensusYear || p.year === popSeries.latest.year);

// WebSite search: the hero box reads ?q= on load, so the SearchAction target is a real URL.
// The layout already emits the WebSite node with this @id; this adds its potentialAction.
const websiteSearchNode = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE_URL}/#website`,
  url: SITE_URL,
  potentialAction: {
    "@type": "SearchAction",
    target: { "@type": "EntryPoint", urlTemplate: `${SITE_URL}/?q={search_term_string}` },
    "query-input": "required name=search_term_string"
  }
};

// Regional summary
const regionCounts = new Map<string, { count: number; avgWbi2021: number; sumPop: number }>();
for (const area of publicAreas) {
  const r = regionCounts.get(area.regionName) ?? { count: 0, avgWbi2021: 0, sumPop: 0 };
  r.count++;
  r.avgWbi2021 += (area.wbiPct2021 ?? 0) * (area.population ?? 0);
  r.sumPop += area.population ?? 0;
  regionCounts.set(area.regionName, r);
}
const regionsByName = [...regionCounts.entries()]
  .map(([name, r]) => ({ name, count: r.count, avgWbi: r.sumPop > 0 ? (r.avgWbi2021 / r.sumPop) : 0, pop: r.sumPop }))
  .filter(r => r.name !== "Unknown")
  .sort((a, b) => a.name.localeCompare(b.name));

// When the published projection takes each area below a 50% White British share, as a
// decade between two model years: never a year interpolated between them, and never a
// list ordered by how soon (maps plan v2.2, I28). Only areas comfortably majority White
// British today (60% or more at the 2021 Census): for an area next to the line the
// decade is carried by where it started, inside the model's own error.
const CROSSING_MIN_BASE_PCT = 60;
const crossingByDecade = PROJECTION_DECADES.map((to, k) => {
  const from = k === 0 ? 2021 : PROJECTION_DECADES[k - 1];
  const areas = publicAreas
    .filter((area) => {
      const rec = projData.areas[area.areaCode];
      const d = crossingDecade(rec);
      const now = censusWhiteBritish2021(rec);
      return d !== null && d !== "already" && d.to === to && now != null && now >= CROSSING_MIN_BASE_PCT;
    })
    .sort((a, b) => a.areaName.localeCompare(b.areaName));
  return { from, to, areas };
}).filter((d) => d.areas.length > 0);

const crossingAlready = publicAreas.filter((area) => crossingDecade(projData.areas[area.areaCode]) === "already").length;

// Get latest findings
const allFindings = await getCollection("findings");
const topFindings = allFindings
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

function findingLabel(verdict: string): string {
  const labels: Record<string, string> = {
    critical: "INVESTIGATION",
    alert: "FINDING",
    info: "ANALYSIS",
    resolved: "RESOLVED",
  };
  return labels[verdict] ?? "FINDING";
}

function findingColor(verdict: string): string {
  const colors: Record<string, string> = {
    critical: "var(--coral)",
    alert: "var(--accent-3)",
    info: "var(--accent)",
    resolved: "var(--accent-2)",
  };
  return colors[verdict] ?? "var(--accent)";
}
---

<BaseLayout
  title="UK demographics: population and projections for every area"
  description={`Population, ethnicity and projections to 2061 for ${fmtInt(totalAreas)} local authorities, and profiles of ${fmtInt(PCON_COUNT)} constituencies, built from the Census and other official statistics.`}
  structuredData={[websiteSearchNode]}
>
  <!-- HERO -->
  <section class="hero-section">
    <div class="hero-inner">
      <div class="hero-main">
      <div class="hero-eyebrow">ONS estimates to mid-{popSeries.latest.year} &middot; Census 2021 projected to 2061 &middot; model v8.0</div>
      <h1 class="hero-headline">How is your area changing?</h1>
      <p class="hero-subline">
        Put in a postcode and get the whole picture for that community: how its population
        has changed since {popSeries.base.year}, the ethnic projection to 2061, who is arriving
        and why, school and housing pressure, and the constituency it sits in. Twenty three
        datasets, one page, every figure sourced.
      </p>

      <div class="hero-search">
        <input
          type="search"
          id="area-search"
          placeholder="Enter a postcode, council or constituency"
          autocomplete="off"
          spellcheck="false"
          aria-label="Search for a local authority"
          aria-describedby="area-search-note"
        />
        <div class="lookup-results" id="area-results" hidden></div>
      </div>
      <p class="hero-search-note" id="area-search-note">
        A postcode is sent to Postcodes.io to find its council. This site does not record it.{" "}
        <a href="/privacy/#postcode-lookup">Privacy details</a>.
      </p>

      <ul class="hero-trust">
        <li><strong>{fmtInt(totalAreas)}</strong> local authorities</li>
        <li><strong>{PCON_COUNT}</strong> constituencies</li>
        <li><strong>23</strong> datasets per area</li>
        <li>Free to reuse with attribution</li>
      </ul>

      <a class="hero-source" href="/methodology/">
        Scored against Census 2021 before publication: 1.56pp average error, +0.05pp bias, 285 areas &rarr;
      </a>
      </div>

      <div class="hero-aside">
      <aside class="hero-panel hero-panel--population" aria-labelledby="hero-pop-title">
        <span class="hero-panel-eyebrow">England and Wales</span>
        <h2 class="hero-panel-title" id="hero-pop-title">Population, mid-{popSeries.base.year} to mid-{popSeries.latest.year}</h2>
        <p class="hero-pop-lead">
          <strong>{fmtInt(popSeries.latest.population)}</strong> people at mid-{popSeries.latest.year},{" "}
          {popSeries.change >= 0 ? "up" : "down"} {fmtInt(Math.abs(popSeries.change))} ({Math.abs(popSeries.changePct).toFixed(1)}%) since mid-{popSeries.base.year}.
        </p>
        <svg
          class="hero-pop-chart"
          viewBox={`0 0 ${POP_W} ${POP_H}`}
          role="img"
          aria-label={`Line chart of the population of England and Wales at 30 June each year from ${popSeries.base.year} to ${popSeries.latest.year}: ${fmtInt(popSeries.base.population)} in ${popSeries.base.year}, ${fmtInt(popSeries.latest.population)} in ${popSeries.latest.year}.`}
        >
          {popTicks.map((t) => (
            <g class="hero-pop-grid">
              <line x1={POP_L} x2={POP_W - POP_R} y1={popY(t)} y2={popY(t)} />
              <text x={POP_L - 6} y={popY(t) + 3.5} text-anchor="end">{t / 1e6}m</text>
            </g>
          ))}
          <path class="hero-pop-line" d={popPath} />
          {popSeries.points.map((p) => (
            <g class="hero-pop-point">
              <circle class="hero-pop-hit" cx={popX(p.year)} cy={popY(p.population)} r="9"><title>Mid-{p.year}: {fmtInt(p.population)}</title></circle>
              {popLabelled.includes(p) && <circle class="hero-pop-dot" cx={popX(p.year)} cy={popY(p.population)} r="4" />}
            </g>
          ))}
          {popLabelled.map((p) => (
            <text
              class="hero-pop-label"
              x={popX(p.year)}
              y={popY(p.population) - 10}
              text-anchor={p.year === popSeries.base.year ? "start" : "end"}
              dx={p.year === popSeries.latest.year || p.year === popSeries.base.year ? 0 : -6}
            >{fmtMillions(p.population)}</text>
          ))}
          {popLabelled.map((p) => (
            <text class="hero-pop-year" x={popX(p.year)} y={POP_H - 8} text-anchor={p.year === popSeries.latest.year ? "end" : p.year === popSeries.base.year ? "start" : "middle"}>{p.year}</text>
          ))}
        </svg>
        <p class="hero-panel-note">
          Source: {MYE_SERIES_SOURCE_LINE}. Resident population at 30 June each year, the sum of
          the {fmtInt(popSeries.areas)} local authorities this site covers, which is the
          workbook's England and Wales total. The axis starts at {popMin / 1e6} million.
        </p>
      </aside>

      <aside class="hero-panel">
        <span class="hero-panel-eyebrow">England and Wales</span>
        <h2 class="hero-panel-title">White British share of population</h2>
        <div class="hero-traj">
          {[
            { yr: "2011", v: natWb2011, kind: "past", gloss: "four in five" },
            { yr: "2021", v: natWb2021, kind: "now", gloss: "three in four" },
            { yr: "2051", v: natWb2051, kind: "proj", gloss: "just over half" }
          ].map((r) => (
            <div class="hero-traj-row">
              <span class="hero-traj-year">{r.yr}</span>
              <span class="hero-traj-track">
                <span class={`hero-traj-fill hero-traj-fill--${r.kind}`} style={`width: ${r.v.toFixed(1)}%`}></span>
              </span>
              <span class="hero-traj-pct">{fmtPct1(r.v)}</span>
              <span class="hero-traj-gloss">{r.gloss}</span>
            </div>
          ))}
        </div>
        <div class="hero-traj-key">
          <span><i class="hero-key-sw hero-key-sw--now"></i>Census</span>
          <span><i class="hero-key-sw hero-key-sw--proj"></i>Projected</span>
        </div>
        <p class="hero-panel-note">
          Census years are England and Wales as a whole, each weighted by its own population:
          2011 from Census table KS201EW across {fmtInt(census2011.areas)} authorities on 2011
          boundaries, 2021 from TS021 across all {fmtInt(census2021.areas)} areas. 2051 covers the {natAgg.n2051} where
          the model is still projecting demography rather than running away from it, and 2061 the
          {natAgg.n2061} it reaches at all, so a 2061 bar would not be measuring the same country
          as the three above it. On those {natAgg.n2061} areas alone the share runs
          {fmtPct1(natAgg.wb2051on2061Geo)} in 2051 to {fmtPct1(natAgg.wb2061)} in 2061.
          The 2051 figure is not all one model: {natAgg.nLegacy} areas carry projections from an
          earlier run the current code cannot reproduce, {natAgg.legacyPopPct.toFixed(1)}% of the
          weighted population. Across the {natAgg.nCurrent} areas the current model produces, 2051
          is {fmtPct1(natAgg.wb2051Current)}.
        </p>
      </aside>
      </div>
    </div>
  </section>

  <!-- ═══ TOP FINDINGS ═══ -->
  {topFindings.length > 0 && (
    <section class="findings-strip shell">
      <h2 class="strip-title">Latest research</h2>
      <div class="findings-row">
        {topFindings.map((finding) => (
          <a href={`/findings/${finding.id.replace(/\.md$/, "")}/`} class="finding-strip-card">
            <span class="fsc-verdict" style={`color: ${findingColor(finding.data.verdict)}`}>{findingLabel(finding.data.verdict)}</span>
            <span class="fsc-stat" style={`color: ${findingColor(finding.data.verdict)}`}>{finding.data.stat_value}</span>
            <span class="fsc-headline">{finding.data.headline}</span>
            <span class="fsc-cta">Read more &rarr;</span>
          </a>
        ))}
      </div>
      <a href="/findings/" class="cta-link">All {allFindings.length} findings &rarr;</a>
    </section>
  )}

  <!-- IMPACT STRIP -->
  <section class="impact-strip shell" aria-label="Headline demographic impact">
    <div class="impact-strip-inner">
      <div class="impact-item impact-item--hero impact-item--population">
        <span class="impact-number">{fmtInt(popSeries.latest.population)}</span>
        <span class="impact-label">people in England and Wales, mid-{popSeries.latest.year}</span>
        <span class="impact-context">{fmtSigned(popSeries.change)} ({fmtSignedPct(popSeries.changePct)}) since mid-{popSeries.base.year}, across the {fmtInt(popSeries.areas)} local authorities this site covers.</span>
        <span class="impact-calc">Source: {MYE_SERIES_SOURCE_LINE}.</span>
      </div>
      <div class="impact-item impact-item--ethnic">
        <span class="impact-number">{fmtPct1(natWb2021)} &rarr; {fmtPct1(natWb2051)}</span>
        <span class="impact-label">White British share, 2021 &rarr; 2051</span>
        <span class="impact-context">Observed Census 2021 across {fmtInt(totalAreas)} local authorities, against the Hamilton-Perry projection across the {natAgg.n2051} where 2051 is publishable.</span>
        <span class="impact-calc">2061, across the {natAgg.n2061} areas the model reaches that far: {fmtPct1(natAgg.wb2051on2061Geo)} in 2051 to {fmtPct1(natWb2061)}. Those same {natAgg.n2061} areas, not the {natAgg.n2051} above. Full trajectory in the model below.</span>
      </div>
      <div class="impact-item">
        <span class="impact-number">{areasBelow50}</span>
        <span class="impact-label">of {below2051.covered} areas below 50% White British by 2051</span>
        <span class="impact-context">{areasBelow50by2061} of the {below2061.covered} areas the model reaches by 2061. Click any area for its 2011 to 2061 trajectory.</span>
      </div>
      <div class="impact-item">
        <span class="impact-number">{foreignBornMajority2051}</span>
        <span class="impact-label">areas projected foreign-born majority by 2051</span>
        <span class="impact-context">{muslimMajority2051} projected Muslim majority by 2051.</span>
      </div>
    </div>
    <p class="impact-source">Population: ONS mid-year estimates. Ethnicity: Census 2011 and 2021 observed. 2051 and 2061 projected by Hamilton-Perry CCR model, 1,000 Monte Carlo simulations. The model was fitted on Census 2001 to 2011 and scored against Census 2021: mean absolute error 1.56 percentage points on that one-decade forecast, bias +0.05 points across 285 areas. Areas where the model diverged are withheld. <a href="/methodology/">Full methodology &rarr;</a></p>
  </section>

  <!-- ═══ DEMOGRAPHIC PROJECTIONS ═══ -->
  <section class="demo-section shell" id="demographics">
    <div class="demo-inner">
      <span class="chip accent" style="margin-bottom: 0.75rem;">Hamilton-Perry model, tested out of sample against Census 2021</span>
      <h2 class="section-title">National ethnic composition trajectory</h2>
      <p class="section-desc" style="max-width: 700px;">
        The ONS does not project ethnic composition at local authority level. This model does.
        {fmtInt(totalAreas)} local authorities. Census 2011 and 2021 observed data. Hamilton-Perry CCR methodology.
        1,000 Monte Carlo simulations. Every ratio traced to Census observations.
      </p>

      <!-- Key stats grid -->
      <div class="stat-card-row" style="margin-top: 1.5rem;">
        <StatCard
          value={areasBelow50.toString()}
          label="areas WBI under 50% by 2051"
          accent="var(--coral)"
        />
        <StatCard
          value={areasBelow50by2061.toString()}
          label={`areas WBI under 50% by 2061, of ${below2061.covered} projected`}
          accent="var(--accent-3)"
        />
        <StatCard
          value={muslimMajority2051.toString()}
          label="areas projected Muslim majority by 2051"
          accent="var(--accent-3)"
        />
        <StatCard
          value={foreignBornMajority2051.toString()}
          label="areas projected foreign-born majority by 2051"
          accent="var(--accent)"
        />
      </div>

      <!-- The decade each area crosses 50%, from the published projection years only. -->
      <div class="cross-section">
        <h3 class="cross-title">When the projection takes these areas below half</h3>
        <p class="cross-desc">
          Areas with a White British share of 60% or more at the 2021 Census, grouped by the
          decade in which the projection first puts the share below half, A to Z. The model
          projects 2031, 2041, 2051 and 2061 only, so the decade is as precise as it can be.
          Areas closer to the line are left out: their decade is carried by where they started
          rather than by the trend. {crossingAlready} areas were already below half at the 2021 Census.
        </p>
        {crossingByDecade.map((d) => (
          <details class="cross-decade">
            <summary><span class="cross-span">Between {d.from} and {d.to}</span> <span class="cross-count">{d.areas.length} {d.areas.length === 1 ? "area" : "areas"}</span></summary>
            <ul class="cross-list">
              {d.areas.map((a) => (
                <li><a href={`/places/${slugifyAreaName(a.areaName)}/`}>{a.areaName}</a></li>
              ))}
            </ul>
          </details>
        ))}
        <p class="cross-note">
          Source: Census 2021 (ONS, table TS021) projected with Hamilton-Perry v8.0, mean absolute
          error 1.56pp on a one-decade out-of-sample test. Projected years past an area's
          plausibility horizon are withheld and not counted.
        </p>
      </div>

      <div class="chip-row" style="margin-top: 1.5rem;">
        <a href="/findings/" class="cta-btn cta-btn--primary">See the research</a>
        <a href="/national/" class="cta-btn cta-btn--secondary">National demographic outlook</a>
        <a href="/methodology/" class="cta-btn cta-btn--ghost">Methodology</a>
      </div>
    </div>
  </section>

  <!-- YOUR AREA IN 2051 -->
  <section class="future-section shell" id="your-area">
    <div class="future-inner">
      <span class="chip accent" style="margin-bottom: 0.5rem;">Explore the data</span>
      <h2 class="section-title">What does your area look like in 2051?</h2>
      <p class="section-desc" style="max-width: 600px;">
        {fmtInt(totalAreas)} local authority profiles. Demographic projections to 2061, religion, nativity, shift-share analysis, school data, economic profiles.
      </p>
      <div class="future-search">
        <input
          type="search"
          id="future-search"
          placeholder="Type your council name..."
          autocomplete="off"
          spellcheck="false"
          aria-label="Search for your area"
        />
        <div class="future-results" id="future-results" hidden></div>
      </div>
      <div class="future-preview" id="future-preview" hidden>
        <div class="future-card">
          <h3 id="future-area-name"></h3>
          <div class="future-stats">
            <div class="future-stat">
              <span class="future-stat-label">Population</span>
              <span class="future-stat-value" id="future-pop"></span>
            </div>
            <div class="future-stat">
              <span class="future-stat-label">White British 2021</span>
              <span class="future-stat-value" id="future-wb-now"></span>
            </div>
            <div class="future-stat">
              <span class="future-stat-label">White British 2051</span>
              <span class="future-stat-value" id="future-wb-2051"></span>
            </div>
          </div>
          <a class="cta-btn cta-btn--primary" id="future-link" href="/places/">See the full profile &rarr;</a>
        </div>
      </div>
      <a href="/places/" class="cta-link" style="margin-top: 1rem;">Browse all {fmtInt(totalAreas)} areas &rarr;</a>
    </div>
  </section>

  <!-- ═══ REGIONAL OVERVIEW ═══ -->
