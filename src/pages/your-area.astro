---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublicPlaceAreas, slugifyAreaName } from "../lib/site";

const areas = getPublicPlaceAreas();
---

<BaseLayout
  title="Your area, postcode lookup"
  description="Enter your postcode or area name to see demographic projections for your community. Ethnic composition, housing, schools, and more."
>
  <section class="lookup-hero">
    <span class="lookup-eyebrow">Postcode, council, ward or constituency</span>
    <h1>Start with the postcode you know</h1>
    <p class="desc">
      One box, four answers: the council that runs your services, the county above it
      where there is one, the Westminster seat, and the projection for all of them.
      Nothing is behind a login and nothing is estimated without saying so.
    </p>

    <div class="search-box">
      <input
        type="search"
        id="postcode-input"
        placeholder="Enter postcode (e.g. B1 1BB) or area name..."
        autocomplete="off"
        spellcheck="false"
        aria-label="Postcode or area name"
      />
      <div class="search-results" id="search-results" hidden></div>
    </div>

    <div class="preview-card" id="preview-card" hidden>
      <h2 id="preview-name"></h2>
      <div class="preview-stats">
        <div class="preview-stat">
          <span class="preview-label">Population</span>
          <span class="preview-value" id="preview-pop"></span>
        </div>
        <div class="preview-stat">
          <span class="preview-label">White British 2021</span>
          <span class="preview-value" id="preview-wbi-now"></span>
        </div>
        <div class="preview-stat">
          <span class="preview-label">White British 2051 projected</span>
          <span class="preview-value" id="preview-wbi-2051"></span>
        </div>
        <div class="preview-stat">
          <span class="preview-label">Region</span>
          <span class="preview-value" id="preview-region"></span>
        </div>
      </div>
      <a class="cta-btn cta-btn--primary" id="preview-link" href="/places/">See the full demographic profile &rarr;</a>
    </div>
  </section>

  <section class="ya-what">
    <div class="ya-what-col">
      <span class="lookup-eyebrow">What a profile contains</span>
      <h2>Everything on one page</h2>
      <ol class="ya-steps">
        <li>
          <span class="ya-step-n">01</span>
          <span>
            <strong>Projection to 2061.</strong>
            Ethnic composition decade by decade, with an 80% interval rather than a single
            point estimate, and the year the area is projected to cross 50% where that year
            is carried by the trend rather than by where it started.
          </span>
        </li>
        <li>
          <span class="ya-step-n">02</span>
          <span>
            <strong>Who is arriving.</strong>
            National Insurance registrations by nationality, age and sex, the visa routes
            behind them, and how the last 24 years compare.
          </span>
        </li>
        <li>
          <span class="ya-step-n">03</span>
          <span>
            <strong>Pressure on services.</strong>
            School places and first language, housing tenure and stress, adult social care,
            SEND, PIP and health by group.
          </span>
        </li>
        <li>
          <span class="ya-step-n">04</span>
          <span>
            <strong>Your politics.</strong>
            The Westminster seats the area covers, the 2024 result in each, and the sitting MP.
          </span>
        </li>
      </ol>
    </div>

    <div class="ya-what-col">
      <span class="lookup-eyebrow">No postcode handy</span>
      <h2>Or pick a way in</h2>
      <div class="ya-ways">
        <a href="/places/" class="ya-way">
          <span class="lookup-eyebrow">{areas.length} councils</span>
          <span class="ya-way-title">Browse every area</span>
        </a>
        <a href="/constituencies/" class="ya-way">
          <span class="lookup-eyebrow">631 seats</span>
          <span class="ya-way-title">Browse constituencies</span>
        </a>
        <a href="/regional/" class="ya-way">
          <span class="lookup-eyebrow">10 regions</span>
          <span class="ya-way-title">Start regionally</span>
        </a>
        <a href="/compare/" class="ya-way">
          <span class="lookup-eyebrow">Side by side</span>
          <span class="ya-way-title">Compare two places</span>
        </a>
      </div>
      <p class="ya-privacy">
        The postcode lookup runs in your browser against the ONS postcode directory.
        Nothing you type is sent anywhere or recorded.
      </p>
    </div>
  </section>

</BaseLayout>

<script>
  const input = document.getElementById("postcode-input") as HTMLInputElement;
  const results = document.getElementById("search-results")!;
  const previewCard = document.getElementById("preview-card")!;

  let allAreas: any[] = [];

  fetch("/search-index.json")
    .then(r => r.json())
    .then(data => { allAreas = Array.isArray(data) ? data : data.areas ?? []; })
    .catch(() => {});

  const postcodeRegex = /^[A-Z]{1,2}\d[A-Z\d]?\s*\d[A-Z]{2}$/i;
  const partialRegex = /^[A-Z]{1,2}\d[A-Z\d]?\s*\d/i;
  let timeout: ReturnType<typeof setTimeout> | null = null;

  function slugify(name: string) {
    return name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
  }

  function showPreview(area: any) {
    const name = document.getElementById("preview-name");
    const pop = document.getElementById("preview-pop");
    const wbiNow = document.getElementById("preview-wbi-now");
    const wbi2051 = document.getElementById("preview-wbi-2051");
    const region = document.getElementById("preview-region");
    const link = document.getElementById("preview-link") as HTMLAnchorElement;

    if (name) name.textContent = area.areaName;
    if (pop) pop.textContent = area.population ? area.population.toLocaleString() : "n/a";
    if (wbiNow) wbiNow.textContent = area.wbiNow ? `${area.wbiNow}%` : (area.wbiPct2021 ? `${area.wbiPct2021}%` : "n/a");
    if (wbi2051) wbi2051.textContent = area.wbi2051 ? `${area.wbi2051}%` : "n/a";
    if (region) region.textContent = area.regionName ?? "Unknown";
    if (link) link.href = `/places/${slugify(area.areaName)}/`;

    previewCard.hidden = false;
  }

  input?.addEventListener("input", () => {
    const q = input.value.trim();
    results.innerHTML = "";
    previewCard.hidden = true;

    if (q.length < 2) { results.hidden = true; return; }

    // Postcode lookup
    if (postcodeRegex.test(q) || (partialRegex.test(q) && q.length >= 5)) {
      results.hidden = false;
      results.innerHTML = '<div class="result-item" style="opacity:0.5">Looking up postcode...</div>';
      if (timeout) clearTimeout(timeout);
      timeout = setTimeout(() => {
        const clean = q.replace(/\s+/g, "").toUpperCase();
        fetch(`https://api.postcodes.io/postcodes/${clean}`)
          .then(r => r.json())
          .then(data => {
            if (data.status === 200 && data.result) {
              const district = data.result.admin_district;
              const laCode = data.result.codes?.admin_district;
              const matched = allAreas.find(a => a.areaCode === laCode);
              results.innerHTML = "";
              results.hidden = false;
              const link = document.createElement("a");
              link.href = `/places/${slugify(district)}/`;
              link.className = "result-item";
              link.innerHTML = `<strong>${q.toUpperCase()} &rarr; ${district}</strong><span>${matched?.regionName ?? ""} · View demographic projections</span>`;
              link.addEventListener("click", (e) => { if (matched) { e.preventDefault(); showPreview(matched); }});
              results.appendChild(link);
              if (matched) showPreview(matched);
            } else {
              results.innerHTML = '<div class="result-item" style="opacity:0.5">Postcode not found</div>';
            }
          })
          .catch(() => { results.innerHTML = '<div class="result-item" style="opacity:0.5">Could not look up postcode</div>'; });
      }, 300);
      return;
    }

    // Name search
    const matches = allAreas.filter(a => a.areaName && a.areaName.toLowerCase().includes(q.toLowerCase())).slice(0, 8);
    if (!matches.length) { results.hidden = true; return; }
    results.hidden = false;
    for (const area of matches) {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "result-item";
      btn.innerHTML = `<strong>${area.areaName}</strong><span>${area.regionName ?? ""}</span>`;
      btn.addEventListener("click", () => { input.value = area.areaName; results.hidden = true; showPreview(area); });
      results.appendChild(btn);
    }
  });

  input?.addEventListener("keydown", (e) => {
    if (e.key === "Escape") { results.hidden = true; previewCard.hidden = true; input.value = ""; }
  });
</script>

<style>
  /* Left aligned on the same grid as the rest of the site. Centred type with a centred
     box under it is a landing page pattern; this is a tool. */
  .lookup-hero { text-align: left; padding: 3rem 0 0; }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.6vw, 3.2rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.05em;
    margin: 0.45rem 0 0;
    max-width: 18ch;
    text-wrap: balance;
  }
  .desc { color: var(--text-muted); font-size: 1.02rem; line-height: 1.72; margin: 0.85rem 0 1.6rem; max-width: 58ch; }
  .search-box { position: relative; width: min(38rem, 100%); margin: 0; text-align: left; }
  .search-box input { width: 100%; padding: 1.1rem 1.25rem; font-size: 1.05rem; font-family: var(--font-sans); color: var(--ink); background: var(--bg-soft); border: 2px solid var(--border-strong); border-radius: var(--radius-sm); outline: none; }
  .search-box input:focus { border-color: var(--accent); box-shadow: 0 0 0 4px var(--accent-glow); }
  .search-results { position: absolute; top: calc(100% + 4px); left: 0; right: 0; background: var(--bg-soft); border: 1px solid var(--border-strong); border-radius: var(--radius-sm); max-height: 320px; overflow-y: auto; z-index: 50; }
  .search-results[hidden] { display: none; }
  :global(.result-item) { display: flex; flex-direction: column; padding: 0.75rem 1.25rem; text-decoration: none; color: var(--ink); border: none; background: none; width: 100%; text-align: left; font-family: inherit; border-bottom: 1px solid var(--border); cursor: pointer; transition: background 120ms; }
  :global(.result-item:hover) { background: color-mix(in srgb, var(--accent) 8%, transparent); }
  :global(.result-item strong) { font-size: 0.95rem; }
  :global(.result-item span) { font-size: 0.82rem; color: var(--muted); }

  .preview-card { max-width: 560px; margin: 2rem auto 0; background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 1.5rem; text-align: left; }
  .preview-card[hidden] { display: none; }
  .preview-card h2 { font-family: var(--font-display); font-size: 1.4rem; font-weight: 600; margin: 0 0 1rem; color: var(--ink); }
  .preview-stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; margin-bottom: 1.25rem; }
  .preview-stat { display: flex; flex-direction: column; }
  .preview-label { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  .preview-value { font-family: var(--font-display); font-size: 1.2rem; font-weight: 600; color: var(--accent); }

  .browse-section { text-align: center; padding: 2rem 0; border-top: 1px solid var(--border); margin-top: 2rem; }
  .browse-section h2 { font-family: var(--font-display); font-size: 1.1rem; font-weight: 600; margin: 0 0 1rem; }
  .region-links { display: flex; gap: 1rem; justify-content: center; }
  .region-links a { color: var(--accent); font-weight: 600; text-decoration: none; }
  .region-links a:hover { text-decoration: underline; }

  @media (max-width: 640px) { .preview-stats { grid-template-columns: 1fr; } }

  .lookup-eyebrow {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .ya-what {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 3rem;
    margin-top: 3rem;
    padding-top: 2.4rem;
    border-top: 1px solid var(--border);
  }
  .ya-what h2 {
    margin: 0.35rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    font-weight: 600;
    letter-spacing: -0.045em;
  }
  .ya-steps { list-style: none; margin: 1.4rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 1.3rem; }
  .ya-steps li { display: grid; grid-template-columns: 2.4rem minmax(0, 1fr); gap: 1rem; align-items: start; }
  .ya-step-n {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--accent);
    line-height: 1.25;
  }
  .ya-steps strong { color: var(--text); }
  .ya-steps li > span:last-child { color: var(--text-muted); font-size: 0.98rem; line-height: 1.7; }
  .ya-ways { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.8rem; margin-top: 1.4rem; }
  .ya-way {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.05rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    box-shadow: var(--shadow-soft);
    text-decoration: none;
    color: inherit;
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }
  .ya-way:hover { border-color: var(--accent-bright); box-shadow: var(--shadow); }
  .ya-way-title { font-family: var(--font-display); font-size: 1.05rem; font-weight: 600; letter-spacing: -0.025em; }
  .ya-privacy { margin: 1.2rem 0 0; font-size: 0.79rem; line-height: 1.6; color: var(--text-faint); }
  @media (max-width: 860px) {
    .ya-what { grid-template-columns: minmax(0, 1fr); gap: 2.2rem; }
  }
</style>
