---
import BaseLayout from "../layouts/BaseLayout.astro";
import { DEFAULT_SOCIAL_IMAGE_PATH, buildAbsoluteUrl, buildReleaseCollectionStructuredData } from "../lib/site";
import { FEED_PATH, RELEASES, RELEASES_DESCRIPTION, RELEASES_PATH, releaseAnchor, releaseLink } from "../lib/releases";

// The entries live in src/lib/releases.ts, which the feed at /feed.xml reads too.
const releases = [...RELEASES];
const pageDescription = RELEASES_DESCRIPTION;
const pageStructuredData = buildReleaseCollectionStructuredData(releases, {
  canonicalUrl: buildAbsoluteUrl(RELEASES_PATH),
  description: pageDescription,
  socialImageUrl: buildAbsoluteUrl(DEFAULT_SOCIAL_IMAGE_PATH)
});
---

<BaseLayout
  title="Releases"
  description={pageDescription}
  structuredData={pageStructuredData}
>
  <h1>Releases</h1>
  <p class="desc">Model updates, data refreshes, and new features, newest first.</p>
  <p class="feed-line">
    Follow these in a feed reader:{" "}
    <a href={FEED_PATH} type="application/rss+xml">ukdemographics.co.uk{FEED_PATH}</a>.
    The feed asks for no account and no email address.
  </p>

  <div class="release-list">
    {releases.map((release) => {
      const link = releaseLink(release);
      return (
        <article class="release-card" id={releaseAnchor(release)}>
          <time class="release-date" datetime={release.date}>{release.date}</time>
          <h2 class="release-title">{release.title}</h2>
          <p class="release-summary">{release.summary}</p>
          {link && (
            <p class="release-link">
              <a href={link.href} rel={link.external ? "noopener" : undefined}>{link.label}</a>
            </p>
          )}
        </article>
      );
    })}
  </div>
</BaseLayout>

<style>
  h1 { font-family: var(--font-display); font-size: 1.8rem; font-weight: 600; margin: 0 0 0.5rem; }
  .desc { color: var(--muted); font-size: 0.92rem; margin: 0 0 0.5rem; }
  .feed-line { color: var(--ink-soft); font-size: 0.92rem; margin: 0 0 1.5rem; max-width: 700px; }
  .release-list { max-width: 700px; }
  .release-card { padding: 1.25rem 0; border-bottom: 1px solid var(--border); scroll-margin-top: 7.5rem; }
  .release-date { font-size: 0.82rem; color: var(--muted); }
  .release-title { font-family: var(--font-display); font-size: 1.1rem; font-weight: 600; margin: 0.25rem 0; color: var(--ink); }
  .release-summary { font-size: 0.92rem; color: var(--ink-soft); margin: 0; }
  .release-link { font-size: 0.88rem; margin: 0.4rem 0 0; overflow-wrap: anywhere; }
</style>
