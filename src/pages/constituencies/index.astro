---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllPcons } from "../../lib/pcon-data";

const all = getAllPcons();

// Group by country for the index.
const byCountry: Record<string, typeof all> = {};
for (const p of all) {
  (byCountry[p.country] = byCountry[p.country] ?? []).push(p);
}
for (const list of Object.values(byCountry)) {
  list.sort((a, b) => a.name.localeCompare(b.name));
}

const countryOrder = ["England", "Wales", "Scotland", "Northern Ireland", "UK"];
const partyColors: Record<string, string> = {
  Labour: "#dc241f",
  "Reform UK": "#12b6cf",
  Conservative: "#0087dc",
  "Liberal Democrats": "#faa61a",
  "Green Party": "#6ab023",
  "Plaid Cymru": "#005b54",
  SNP: "#fdf38e",
  Independent: "#999999",
};

// National vote-share roll-up by winner party.
const winnerCounts: Record<string, number> = {};
for (const p of all) {
  const w = p.ge2024.winner ?? "Unknown";
  winnerCounts[w] = (winnerCounts[w] ?? 0) + 1;
}
const sortedWinners = Object.entries(winnerCounts).sort(([, a], [, b]) => b - a);
---

<BaseLayout
  title="UK constituencies"
  description={`Per-constituency demographic and political profile for ${all.length} of the 650 UK parliamentary constituencies — 2024 General Election results, MP, PIP claimants, and the local authorities that make up each seat.`}
>
  <h1>UK constituencies</h1>
  <p class="desc">{all.length} of 650 constituencies, joined to demographic and welfare data. 2024 General Election results, sitting MP, PIP claimants, and the local authorities that make up each seat.</p>

  <section class="stats-grid">
    {sortedWinners.slice(0, 4).map(([party, n]) => (
      <div class="stat-card" style={`border-left: 4px solid ${partyColors[party] ?? "var(--accent)"}`}>
        <span class="stat-value">{n}</span>
        <span class="stat-label">{party}</span>
      </div>
    ))}
  </section>

  {countryOrder.filter((c) => byCountry[c]?.length).map((c) => (
    <section class="country-block">
      <h2>{c} <span class="muted">({byCountry[c].length})</span></h2>
      <div class="pcon-grid">
        {byCountry[c].map((p) => (
          <a class="pcon-card" href={`/constituencies/${p.slug}/`}>
            <span class="pcon-name">{p.name}</span>
            <span class="pcon-meta">
              <span class="pcon-winner" style={`color: ${partyColors[p.ge2024.winner ?? ""] ?? "var(--muted)"}`}>{p.ge2024.winner ?? "—"}</span>
              <span class="pcon-margin">{p.ge2024.majorityPp != null ? `+${p.ge2024.majorityPp.toFixed(1)}pp` : ""}</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  ))}
</BaseLayout>

<style>
  h1 { font-family: "Sora", sans-serif; font-size: 1.8rem; font-weight: 800; margin: 0 0 0.5rem; }
  .desc { color: var(--muted); font-size: 0.92rem; margin: 0 0 1.5rem; max-width: 800px; }
  .muted { color: var(--muted); font-weight: 400; font-size: 0.9rem; }
  .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 0.75rem; margin-bottom: 2rem; }
  .stat-card { background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 1rem 1.25rem; display: flex; flex-direction: column; gap: 0.2rem; }
  .stat-value { font-family: "Sora", sans-serif; font-size: 1.75rem; font-weight: 800; color: var(--ink); }
  .stat-label { font-size: 0.82rem; color: var(--muted); }
  .country-block { margin-top: 2.5rem; }
  .country-block h2 { font-family: "Sora", sans-serif; font-size: 1.15rem; font-weight: 800; margin: 0 0 0.75rem; }
  .pcon-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 0.5rem; }
  .pcon-card { display: flex; flex-direction: column; gap: 0.2rem; padding: 0.7rem 0.85rem; background: var(--panel); border: 1px solid var(--border); border-radius: 6px; text-decoration: none; color: var(--ink); transition: background 120ms; }
  .pcon-card:hover { background: rgba(79, 70, 229, 0.06); }
  .pcon-name { font-weight: 600; font-size: 0.9rem; }
  .pcon-meta { display: flex; justify-content: space-between; font-size: 0.78rem; font-family: "Sora", sans-serif; }
  .pcon-winner { font-weight: 700; }
  .pcon-margin { color: var(--muted); }
</style>
