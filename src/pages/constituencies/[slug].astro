---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StatCard from "../../components/StatCard.astro";
import RaceBar from "../../components/RaceBar.astro";
import MiniMap from "../../components/MiniMap.astro";
import {
  getAllPcons,
  getMpForPcon,
  getPipClaimantsForPcon,
  type PconEntry,
} from "../../lib/pcon-data";
import { getPublicPlaceAreas, slugifyAreaName } from "../../lib/site";
import { getPconDemographics } from "../../lib/pcon-demographics";

export function getStaticPaths() {
  return getAllPcons().map((p) => ({
    params: { slug: p.slug },
    props: { pcon: p },
  }));
}

const { pcon } = Astro.props as { pcon: PconEntry };
const mp = getMpForPcon(pcon.name);
const pipClaimants = getPipClaimantsForPcon(pcon.code);
const demog = getPconDemographics(pcon);

// Build LA cross-links. Only show LAs that have a UKD place page.
const publicAreas = getPublicPlaceAreas();
const codeToArea = new Map<string, (typeof publicAreas)[number]>();
for (const a of publicAreas) codeToArea.set(a.areaCode, a);

const constituentLasWithPages = pcon.constituentLas
  .map((l) => ({ ...l, area: codeToArea.get(l.ladCode) }))
  .filter((l) => l.area)
  .slice(0, 10);

const partyColors: Record<string, string> = {
  Labour: "#dc241f",
  "Reform UK": "#12b6cf",
  Conservative: "#0087dc",
  "Liberal Democrats": "#faa61a",
  "Green Party": "#6ab023",
  "Plaid Cymru": "#005b54",
  SNP: "#fdf38e",
  Independent: "#999999",
  "Sinn Fein": "#326760",
  "Sinn Féin": "#326760",
  "DUP": "#d46a4c",
  "Democratic Unionist Party": "#d46a4c",
  "UUP": "#48a5b8",
  "Ulster Unionist Party": "#48a5b8",
  "Alliance": "#f6cb2f",
  "Alliance Party of Northern Ireland": "#f6cb2f",
  "SDLP": "#2c6b3d",
  "Social Democratic and Labour Party": "#2c6b3d",
};

// Build RaceBar segments from the GE2024 result, ordered descending.
const raceBarSegments = Object.entries(pcon.ge2024.shares)
  .filter(([, v]) => v > 0.001)
  .sort(([, a], [, b]) => b - a)
  .map(([party, share]) => ({
    label: party,
    pct: share,
    colour: partyColors[party] ?? "var(--accent)",
  }));

const winnerShareText = pcon.ge2024.winnerSharePct > 0
  ? `${pcon.ge2024.winnerSharePct.toFixed(1)}%`
  : "n/a";

// Search intent: people look for "<constituency> population" and
// "<constituency> MP", not "constituency profile".
const pageTitle = `${pcon.name}. Population, demographics and MP`;
---

<BaseLayout
  title={pageTitle}
  description={`${pcon.name} (UK Parliament constituency ${pcon.code}). 2024 General Election result, MP, PIP claimants and the constituent local authorities.`}
>
  <a class="back-link" href="/constituencies/">&larr; All constituencies</a>
  <div class="pcon-header">
    <div class="pcon-identity">
      <h1>{pcon.name}</h1>
      <p class="meta">
        <span class="meta-tag">{pcon.country}</span>
        <span class="meta-tag">PCON {pcon.code}</span>
      </p>
    </div>
    <MiniMap
      focalCode={pcon.code}
      focalName={pcon.name}
      focalKind="pcon"
      focalColour={pcon.ge2024.winner ? (partyColors[pcon.ge2024.winner] ?? "var(--accent)") : "var(--accent)"}
      contextColour="#243049"
      contextStroke="#4a5b7e"
      width={260}
      height={170}
      padding={1.6}
      ariaLabel={`Location map showing the ${pcon.name} constituency.`}
    />
  </div>

  {mp && (
    <section class="section" id="mp">
      <h2>Sitting MP</h2>
      <div class="mp-card">
        {mp.photoUrl && <img src={mp.photoUrl} alt={mp.mpName} class="mp-photo" loading="lazy" width="80" height="80" />}
        <div class="mp-info">
          <span class="mp-name">{mp.mpName}</span>
          <span class="mp-party" style={`color: ${partyColors[mp.party] ?? "var(--ink)"}`}>{mp.party}</span>
          {mp.electedDate && <span class="mp-elected">Elected {mp.electedDate.slice(0, 10)}</span>}
        </div>
      </div>
    </section>
  )}

  <section class="section" id="ge2024">
    <h2>2024 General Election result</h2>
    <div class="stat-card-row">
      <StatCard
        value={pcon.ge2024.winner ?? "n/a"}
        label="Winner"
        accent={pcon.ge2024.winner ? (partyColors[pcon.ge2024.winner] ?? "var(--accent)") : null}
      />
      <StatCard
        value={winnerShareText}
        label="Winning share"
      />
      <StatCard
        value={pcon.ge2024.majorityPp != null ? `${pcon.ge2024.majorityPp.toFixed(1)}pp` : "n/a"}
        label={pcon.ge2024.runnerUp ? `Majority over ${pcon.ge2024.runnerUp}` : "Majority"}
      />
      <StatCard
        value={pcon.ge2024.totalVotes != null ? pcon.ge2024.totalVotes.toLocaleString() : "n/a"}
        label="Valid votes cast"
      />
    </div>
    <RaceBar
      segments={raceBarSegments}
      title="Vote share by party"
      ariaLabel={`2024 General Election vote shares in ${pcon.name}`}
      height={56}
    />
  </section>

  {pipClaimants != null && (
    <section class="section" id="pip">
      <h2>Personal Independence Payment</h2>
      <div class="stat-card-row" style="grid-template-columns: minmax(0, 18rem);">
        <StatCard
          value={pipClaimants.toLocaleString()}
          label="PIP claimants · Jan 2026"
          accent="var(--accent)"
        />
      </div>
      <p class="section-note">Source: DWP Stat-Xplore, PIP Monthly New. Constituency totals only. No demographic breakdown is published at constituency level.</p>
    </section>
  )}

  {demog && (
    <section class="section" id="demographics">
      <h2>Demographic snapshot</h2>
      <p class="section-desc">
        Aggregated up from the {demog.coverageCount} of {demog.expectedCount} constituent local authority profiles, weighted by share of constituency postcodes and 2021 population. Indicative only: a constituency that takes the dense core of an LA but a small share of its postcodes will be misweighted. For direct Census observations, use the local-authority pages linked below.
      </p>
      <div class="stat-card-row">
        <StatCard
          value={demog.wbi2021 != null ? `${demog.wbi2021.toFixed(1)}%` : "n/a"}
          label="White British 2021 (derived)"
        />
        <StatCard
          value={demog.wbi2051 != null ? `${demog.wbi2051.toFixed(1)}%` : "n/a"}
          label="White British 2051 projected (derived)"
          accent="var(--accent)"
          note="Projected"
          trend={demog.wbi2021 != null && demog.wbi2051 != null ? `${(demog.wbi2051 - demog.wbi2021).toFixed(1)}pp` : null}
          trendDirection="neutral"
        />
        <StatCard
          value={demog.foreignBornPct2021 != null ? `${demog.foreignBornPct2021.toFixed(1)}%` : "n/a"}
          label="Foreign-born 2021 (derived)"
        />
        <StatCard
          value={demog.foreignBornPct2051 != null ? `${demog.foreignBornPct2051.toFixed(1)}%` : "n/a"}
          label="Foreign-born 2051 projected (derived)"
          accent="var(--accent-3)"
        />
      </div>
      {demog.notes.length > 0 && (
        <p class="section-note">{demog.notes.join(" ")}</p>
      )}
      <p class="section-note">Method: each constituent local authority contributes the product of its postcode share within the constituency and its 2021 population. Underlying figures from Census 2021 (ONS custom dataset) and the Hamilton-Perry projection model. See the <a href="/methodology/">methodology page</a> for the projection's limitations and validation.</p>
    </section>
  )}

  {constituentLasWithPages.length > 0 && (
    <section class="section" id="constituent-las">
      <h2>Local authorities in this constituency</h2>
      <p class="section-desc">By share of postcodes from the constituency that fall in each LA.</p>
      <div class="la-grid">
        {constituentLasWithPages.map((l) => (
          <a class="la-card" href={`/places/${slugifyAreaName(l.area!.areaName)}/`}>
            <span class="la-name">{l.area!.areaName}</span>
            <span class="la-share">{(l.postcodeShare * 100).toFixed(1)}% of postcodes</span>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .back-link { display: inline-block; margin-bottom: 1rem; font-size: 0.85rem; color: var(--muted); text-decoration: none; }
  .back-link:hover { color: var(--accent); }
  h1 { font-family: var(--font-display); font-size: clamp(1.5rem, 4vw, 2.2rem); font-weight: 600; margin: 0 0 0.5rem; }
  .meta { display: flex; gap: 0.5rem; margin: 0 0 1.5rem; }
  .pcon-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; margin-bottom: 0.5rem; }
  .pcon-identity { min-width: 0; flex: 1 1 auto; }
  .pcon-header :global(.mini-map) {
    margin: 0;
    padding: 0.4rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 10px;
    line-height: 0;
    flex: 0 0 auto;
    width: 272px;
  }
  .pcon-header :global(.mini-map svg) { display: block; width: 100%; height: auto; }
  @media (max-width: 600px) {
    .pcon-header :global(.mini-map) { width: 100%; max-width: 280px; }
  }
  .meta-tag { display: inline-block; font-size: 0.78rem; padding: 0.2rem 0.55rem; background: var(--panel); border: 1px solid var(--border); border-radius: 999px; color: var(--muted); }
  .section { margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--border); }
  .section h2 { font-family: var(--font-display); font-size: 1.15rem; font-weight: 600; margin: 0 0 0.75rem; }
  .section-desc { color: var(--muted); font-size: 0.92rem; margin: 0 0 1rem; max-width: 700px; }
  .section-note { font-size: 0.82rem; color: var(--muted); margin-top: 0.75rem; }
  .mp-card { display: flex; gap: 1rem; align-items: center; background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 0.85rem 1.1rem; max-width: 460px; }
  .mp-photo { width: 60px; height: 60px; border-radius: 50%; object-fit: cover; }
  .mp-info { display: flex; flex-direction: column; gap: 0.15rem; }
  .mp-name { font-family: var(--font-display); font-size: 1.05rem; font-weight: 600; color: var(--ink); }
  .mp-party { font-size: 0.92rem; font-weight: 600; }
  .mp-elected { font-size: 0.78rem; color: var(--muted); }
  .la-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.5rem; }
  .la-card { display: flex; flex-direction: column; gap: 0.15rem; padding: 0.7rem 0.85rem; background: var(--panel); border: 1px solid var(--border); border-radius: 6px; text-decoration: none; color: var(--ink); transition: background 120ms; }
  .la-card:hover { background: color-mix(in srgb, var(--accent) 8%, transparent); }
  .la-name { font-weight: 600; font-size: 0.92rem; }
  .la-share { font-size: 0.78rem; color: var(--muted); }
</style>
