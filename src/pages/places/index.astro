---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublicPlaceAreas, slugifyAreaName } from "../../lib/site";
import rawProjections from "../../data/live/ethnic-projections.json";

const projData = rawProjections as any;
const areas = getPublicPlaceAreas();

// The year an area is projected to fall below a 50% White British share, interpolated
// between projection decades. 0 means already below; null means the model does not take
// it across the line inside its horizon.
//
// Suppressed where the area starts within about two of the model's mean absolute errors
// of the line (1.56pp on the one-decade test, so 53%): under that the year is carried by the starting
// position rather than by the trend, and quoting one would claim precision the model does
// not have.
const CROSSING_MIN_BASE_PCT = 53;

function crossingYear(code: string): number | null {
  const a = projData?.areas?.[code];
  const now = a?.current?.groups?.white_british;
  if (now == null) return null;
  if (now < 50) return 0;
  if (now < CROSSING_MIN_BASE_PCT) return null;
  const pts: Array<[number, number]> = [[2021, now]];
  for (const y of [2031, 2041, 2051, 2061]) {
    const v = a?.projections?.[String(y)]?.white_british;
    if (v != null) pts.push([y, v]);
  }
  for (let i = 0; i < pts.length - 1; i++) {
    const [y1, v1] = pts[i];
    const [y2, v2] = pts[i + 1];
    if (v1 >= 50 && v2 < 50) return Math.round(y1 + ((v1 - 50) / (v1 - v2)) * (y2 - y1));
  }
  return null;
}

const rows = areas.map((area) => {
  const cross = crossingYear(area.areaCode);
  const w21 = area.wbiPct2021 ?? null;
  const w41 = area.wbiPct2041 ?? null;
  return {
    name: area.areaName,
    slug: slugifyAreaName(area.areaName),
    region: area.regionName,
    pop: area.population ?? 0,
    w21,
    w41,
    change: w21 != null && w41 != null ? w41 - w21 : null,
    cross,
    // "already" sorts first, "not by 2061" last, everything else by year.
    crossSort: cross === 0 ? 0 : cross == null ? 9999 : cross
  };
});

// Default order is population, largest first. The previous default was White British
// share ascending, which puts the lowest at the top of every visit. On a site whose value
// is being read as neutral, the default sort is an editorial statement, and size is the
// one ordering that makes no claim.
rows.sort((a, b) => b.pop - a.pop);

const regions = Array.from(new Set(rows.map((r) => r.region))).filter((r) => r !== "Unknown").sort();
const maxAbsChange = Math.max(...rows.map((r) => Math.abs(r.change ?? 0)), 1);
const alreadyBelow = rows.filter((r) => r.cross === 0).length;
---

<BaseLayout
  title="Compare every area in England and Wales"
  description={`Sort and filter ${areas.length} local authorities by projected change, current composition, the year each is projected to cross 50%, or population.`}
>
  <span class="page-eyebrow">England and Wales, {areas.length} councils</span>
  <h1>Compare every area in England and Wales</h1>
  <p class="desc">
    Sort by the year an area is projected to cross 50%, by projected change, or by size.
    Filter to your region, or type a name to jump straight there. Each row opens a full
    profile with twenty three datasets behind it. {alreadyBelow} areas are already below a
    White British majority.
  </p>

  <div class="pl-controls">
    <div class="pl-search">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path>
      </svg>
      <input type="search" id="places-search" placeholder="Jump to an area" autocomplete="off" spellcheck="false" aria-label="Filter areas by name" />
    </div>
    <span class="pl-count"><strong id="pl-shown">{rows.length}</strong> of {rows.length} shown</span>
    <a class="pl-csv" href="/places/">Download CSV</a>
  </div>

  <div class="pl-regions" role="group" aria-label="Filter by region">
    <button type="button" class="pl-chip" data-region="" aria-pressed="true">All regions</button>
    {regions.map((r) => (
      <button type="button" class="pl-chip" data-region={r} aria-pressed="false">{r}</button>
    ))}
  </div>

  <div class="pl-table" id="pl-table">
    <div class="pl-head" role="row">
      <button type="button" class="pl-sort" data-sort="name" data-dir="asc">Area <span class="pl-mark"></span></button>
      <span>Region</span>
      <button type="button" class="pl-sort pl-num" data-sort="w21" data-dir="desc">2021 <span class="pl-mark"></span></button>
      <button type="button" class="pl-sort pl-num" data-sort="w41" data-dir="desc">2041 <span class="pl-mark"></span></button>
      <button type="button" class="pl-sort pl-num" data-sort="change" data-dir="asc">Change <span class="pl-mark"></span></button>
      <button type="button" class="pl-sort pl-num" data-sort="crossSort" data-dir="asc">Crosses 50% <span class="pl-mark"></span></button>
      <button type="button" class="pl-sort pl-num pl-active" data-sort="pop" data-dir="desc">Population <span class="pl-mark">&darr;</span></button>
    </div>

    {rows.map((r) => (
      <a
        href={`/places/${r.slug}/`}
        class="pl-row"
        data-name={r.name.toLowerCase()}
        data-region={r.region}
        data-w21={r.w21 ?? ""}
        data-w41={r.w41 ?? ""}
        data-change={r.change ?? ""}
        data-crosssort={r.crossSort}
        data-pop={r.pop}
      >
        <span class="pl-name">{r.name}</span>
        <span class="pl-region">{r.region}</span>
        <span class="pl-num pl-figure">{r.w21 != null ? `${r.w21.toFixed(1)}%` : "n/a"}</span>
        <span class="pl-num pl-figure pl-muted">{r.w41 != null ? `${r.w41.toFixed(1)}%` : "n/a"}</span>
        <span class="pl-change">
          {r.change != null && (
            <span class="pl-bar" style={`width: ${Math.round((Math.abs(r.change) / maxAbsChange) * 100)}%`}></span>
          )}
          <span class="pl-num pl-figure pl-change-val">{r.change != null ? `${r.change.toFixed(1)}pp` : "n/a"}</span>
        </span>
        <span class={`pl-num pl-figure pl-cross${r.cross === 0 ? " pl-cross-now" : ""}${r.cross == null ? " pl-cross-none" : ""}`}>
          {r.cross === 0 ? "already" : r.cross == null ? "not by 2061" : r.cross}
        </span>
        <span class="pl-num pl-pop">{r.pop.toLocaleString()}</span>
      </a>
    ))}

    <p class="pl-note">
      Change is the projected shift in White British share, 2021 to 2041; the bar encodes
      percentage points, not the level. A crossing year is only shown where the area is
      more than about two model errors above 50% today, because below that the year is
      carried by where it started rather than by the trend.
      Source: Census 2021 (ONS), Hamilton-Perry v8.0.
    </p>
  </div>
</BaseLayout>

<script>
  const table = document.getElementById("pl-table")!;
  const rows = Array.from(table.querySelectorAll<HTMLAnchorElement>(".pl-row"));
  const search = document.getElementById("places-search") as HTMLInputElement | null;
  const shown = document.getElementById("pl-shown")!;
  const note = table.querySelector(".pl-note")!;
  let region = "";
  let query = "";

  function apply() {
    let visible = 0;
    for (const row of rows) {
      const okRegion = !region || row.dataset.region === region;
      const okQuery = !query || (row.dataset.name ?? "").includes(query);
      const show = okRegion && okQuery;
      row.hidden = !show;
      if (show) visible++;
    }
    shown.textContent = String(visible);
  }

  function sortBy(key: string, dir: string) {
    const sorted = rows.slice().sort((a, b) => {
      if (key === "name") {
        const cmp = (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "");
        return dir === "asc" ? cmp : -cmp;
      }
      const av = a.dataset[key.toLowerCase()];
      const bv = b.dataset[key.toLowerCase()];
      // Rows with no value for this column sort last whichever way the column runs.
      if (av === "" || av == null) return 1;
      if (bv === "" || bv == null) return -1;
      const cmp = Number(av) - Number(bv);
      return dir === "asc" ? cmp : -cmp;
    });
    for (const row of sorted) table.insertBefore(row, note);
  }

  for (const btn of Array.from(table.querySelectorAll<HTMLButtonElement>(".pl-sort"))) {
    btn.addEventListener("click", () => {
      const key = btn.dataset.sort!;
      const wasActive = btn.classList.contains("pl-active");
      const dir = wasActive ? (btn.dataset.dir === "asc" ? "desc" : "asc") : btn.dataset.dir!;
      btn.dataset.dir = dir;
      for (const other of Array.from(table.querySelectorAll(".pl-sort"))) {
        other.classList.remove("pl-active");
        const mark = other.querySelector(".pl-mark");
        if (mark) mark.textContent = "";
      }
      btn.classList.add("pl-active");
      const mark = btn.querySelector(".pl-mark");
      if (mark) mark.textContent = dir === "asc" ? "↑" : "↓";
      sortBy(key, dir);
    });
  }

  for (const chip of Array.from(document.querySelectorAll<HTMLButtonElement>(".pl-chip"))) {
    chip.addEventListener("click", () => {
      region = chip.dataset.region ?? "";
      for (const other of Array.from(document.querySelectorAll(".pl-chip"))) {
        other.setAttribute("aria-pressed", other === chip ? "true" : "false");
      }
      apply();
    });
  }

  search?.addEventListener("input", () => {
    query = search.value.trim().toLowerCase();
    apply();
  });
</script>

<style>
  .pl-controls { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 0.85rem; }
  .pl-search {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 22rem;
    max-width: 100%;
    padding: 0 0.9rem;
    min-height: 2.9rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--bg-card);
    color: var(--text-faint);
  }
  .pl-search input {
    flex-grow: 1;
    border: 0;
    outline: none;
    background: none;
    font: inherit;
    color: var(--text);
  }
  .pl-search:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-wash); }
  .pl-count { font-size: 0.79rem; color: var(--text-faint); }
  .pl-count strong { color: var(--text); }
  .pl-csv {
    margin-left: auto;
    padding: 0.6rem 0.95rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    font-size: 0.86rem;
    font-weight: 600;
    text-decoration: none;
    color: inherit;
  }

  .pl-regions { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1rem; }
  .pl-chip {
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-card);
    color: var(--text-muted);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }
  .pl-chip[aria-pressed="true"] { border-color: var(--accent); background: var(--accent); color: #ffffff; }

  .pl-table { border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-card); overflow: hidden; }
  .pl-head,
  .pl-row {
    display: grid;
    grid-template-columns: 1.5fr 1fr 5rem 5rem 8.5rem 7rem 7rem;
    gap: 1rem;
    align-items: center;
    padding: 0.66rem 1.15rem;
  }
  .pl-head {
    background: var(--bg-subtle);
    border-bottom: 1px solid var(--border);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .pl-sort {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    border: 0;
    background: none;
    padding: 0;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }
  .pl-sort.pl-num { justify-content: flex-end; }
  .pl-sort.pl-active { color: var(--accent); }
  .pl-row { border-bottom: 1px solid var(--border); text-decoration: none; color: inherit; transition: background 140ms ease; }
  .pl-row:hover { background: var(--accent-wash); }
  .pl-row[hidden] { display: none; }
  .pl-name { font-weight: 600; }
  .pl-region { color: var(--text-muted); font-size: 0.9rem; }
  .pl-num { text-align: right; }
  .pl-figure { font-family: var(--font-display); font-weight: 600; }
  .pl-muted { color: var(--text-muted); }
  .pl-change { display: flex; align-items: center; justify-content: flex-end; gap: 0.5rem; }
  .pl-bar { height: 8px; border-radius: 999px; background: var(--accent-bright); flex-shrink: 1; }
  .pl-change-val { color: var(--critical); min-width: 4rem; }
  .pl-cross { color: var(--text); }
  .pl-cross-now { color: var(--accent); }
  .pl-cross-none { color: var(--text-faint); font-family: var(--font-sans); font-weight: 400; font-size: 0.82rem; }
  .pl-pop { font-weight: 400; color: var(--text-muted); font-size: 0.9rem; }
  .pl-note { margin: 0; padding: 0.8rem 1.15rem; background: var(--bg-subtle); font-size: 0.79rem; line-height: 1.6; color: var(--text-faint); }

  /* On a phone the desktop grid would drop columns. Each row becomes a card that keeps
     every value instead. */
  @media (max-width: 860px) {
    .pl-head { display: none; }
    .pl-row {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "name cross"
        "change change"
        "meta meta";
      gap: 0.4rem 1rem;
      padding: 0.9rem 1rem;
    }
    .pl-name { grid-area: name; font-family: var(--font-display); font-size: 1.05rem; letter-spacing: -0.025em; }
    .pl-cross { grid-area: cross; font-size: 1.05rem; }
    .pl-change { grid-area: change; justify-content: flex-start; }
    .pl-bar { flex-shrink: 0; }
    .pl-region,
    .pl-figure:not(.pl-change-val),
    .pl-pop { grid-area: meta; }
    .pl-region { font-size: 0.79rem; }
    .pl-row .pl-figure:not(.pl-change-val),
    .pl-row .pl-pop { display: none; }
    .pl-csv { margin-left: 0; }
  }
</style>
